+#if LV_USE_BIDI
+/* True when the UTF-8 text may need bidi reordering: a letter from a
+ * right-to-left block (Hebrew through the Arabic extensions, the Hebrew and
+ * Arabic presentation forms, or the SMP right-to-left scripts) or an explicit
+ * direction mark, embedding or isolate. Errs towards true. */
+static bool draw_label_line_has_rtl(const char * txt, size_t len)
+{
+    const uint8_t * s = (const uint8_t *)txt;
+    for(size_t i = 0; i < len; i++) {
+        uint8_t c = s[i];
+        if(c < 0xD6) continue;
+        if(c <= 0xDF) return true;                               /* U+0590..U+07FF */
+        uint8_t c1 = i + 1 < len ? s[i + 1] : 0;
+        uint8_t c2 = i + 2 < len ? s[i + 2] : 0;
+        if(c == 0xE0 && c1 >= 0xA0 && c1 <= 0xA3) return true;  /* U+0800..U+08FF */
+        if(c == 0xE2 && c1 == 0x80 && (c2 == 0x8E || c2 == 0x8F || (c2 >= 0xAA && c2 <= 0xAE)))
+            return true;                                         /* LRM RLM, embeddings */
+        if(c == 0xE2 && c1 == 0x81 && c2 >= 0xA6 && c2 <= 0xA9) return true; /* isolates */
+        if(c == 0xEF && ((c1 >= 0xAC && c1 <= 0xB7) || (c1 >= 0xB9 && c1 <= 0xBB)))
+            return true;                                         /* U+FB00..U+FDFF, U+FE70..U+FEFF */
+        if(c == 0xF0 && ((c1 == 0x90 && c2 >= 0xA0) || c1 == 0x9E)) return true; /* SMP RTL */
+    }
+    return false;
+}
+#endif
