+/*A const style can't reach lv_style_set_prop(): note a blur or drop-shadow in it here*/
+static void note_const_blur_shadow(const lv_style_t * style)
+{
+    if(lv_style_blur_shadow_seen || !style || !lv_style_is_const(style)) return;
+    const lv_style_const_prop_t * props = style->values_and_props;
+    for(uint32_t k = 0; props[k].prop != LV_STYLE_PROP_INV; k++) {
+        lv_style_prop_t prop = props[k].prop;
+        if((prop >= LV_STYLE_BLUR_RADIUS && prop <= LV_STYLE_BLUR_QUALITY) ||
+           (prop >= LV_STYLE_DROP_SHADOW_RADIUS && prop <= LV_STYLE_DROP_SHADOW_QUALITY))
+            lv_style_blur_shadow_seen = true;
+    }
+}
