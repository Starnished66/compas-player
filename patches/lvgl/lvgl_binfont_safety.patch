+/* File-system drivers may return fewer bytes than requested at end-of-file. */
+static bool read_exact(lv_fs_file_t * fp, void * data, uint32_t size)
+{
+    uint32_t total = 0;
+    while(total < size) {
+        uint32_t bytes_read = 0;
+        lv_fs_res_t res = lv_fs_read(fp, (uint8_t *)data + total, size - total, &bytes_read);
+        if(res != LV_FS_RES_OK || bytes_read == 0 || bytes_read > size - total) return false;
+        total += bytes_read;
+    }
+    return true;
+}
