+/* Invalidate only the strip a scrolling label's text can touch. In SCROLL and
+ * SCROLL_CIRCULAR the text (and its circular duplicate) is clipped to the content
+ * area, and a pure horizontal scroll keeps the lines inside
+ * [content.y1 + offset.y, + text_size.y]. Everything else (background, border,
+ * children) is unchanged by an offset tick; the redraw re-renders it in the strip,
+ * so the output is identical to a full redraw. Anything unusual -> full invalidate. */
+static void label_invalidate_scroll(lv_obj_t * obj)
+{
+    lv_label_t * label = (lv_label_t *)obj;
+
+    if(label->long_mode != LV_LABEL_LONG_MODE_SCROLL && label->long_mode != LV_LABEL_LONG_MODE_SCROLL_CIRCULAR) {
+        lv_obj_invalidate(obj);
+        return;
+    }
+
+    /*Effects drawn outside the text box, or a transformed object/ancestor: keep the full invalidate*/
+    if(lv_obj_get_style_drop_shadow_opa(obj, LV_PART_MAIN) > 0 || lv_obj_get_style_blur_radius(obj, LV_PART_MAIN) > 0) {
+        lv_obj_invalidate(obj);
+        return;
+    }
+    for(const lv_obj_t * o = obj; o; o = o->parent) {
+        if(o->spec_attr && o->spec_attr->layer_type == LV_LAYER_TYPE_TRANSFORM) {
+            lv_obj_invalidate(obj);
+            return;
+        }
+    }
+
+    lv_area_t strip;
+    lv_obj_get_content_coords(obj, &strip);
+    const int32_t content_h = lv_area_get_height(&strip);
+
+    /*Vertical scrolling (or a vertical circular copy) moves lines through the whole content area*/
+    if(label->offset.y == 0 && label->text_size.y > 0 && label->text_size.y < content_h) {
+        const lv_font_t * font = lv_obj_get_style_text_font(obj, LV_PART_MAIN);
+        /*Glyph ink beyond the line box: font_h/4 like the ext draw size, or the deepest fallback
+         *font's extra descent when larger, plus line/letter spacing and the outline stroke*/
+        const int32_t lh = lv_font_get_line_height(font);
+        int32_t extra = 0;
+        for(const lv_font_t * f = font ? font->fallback : NULL; f; f = f->fallback) {
+            if(f->base_line - font->base_line > extra) extra = f->base_line - font->base_line;
+        }
+        int32_t pad = LV_MAX(lh / 4, extra) + 2;
+        pad += LV_MAX(lv_obj_get_style_text_line_space(obj, LV_PART_MAIN), 0);
+        if(lv_obj_get_style_text_outline_stroke_opa(obj, LV_PART_MAIN) > 0) {
+            pad += LV_MAX(lv_obj_get_style_text_outline_stroke_width(obj, LV_PART_MAIN), 0);
+        }
+        const int32_t y2 = strip.y1 + label->text_size.y - 1 + pad;
+        if(y2 < strip.y2) strip.y2 = y2;
+    }
+
+    /*Ink can reach outside the object by the ext draw size, but the draw is clipped to the content area*/
+    lv_obj_invalidate_area(obj, &strip);
+}
+
