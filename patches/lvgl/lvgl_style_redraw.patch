+        case LV_STYLE_IMAGE_RECOLOR_OPA:
+        case LV_STYLE_BG_IMAGE_RECOLOR:
+        case LV_STYLE_BG_IMAGE_RECOLOR_OPA:
+        case LV_STYLE_LINE_COLOR:
+        case LV_STYLE_ARC_COLOR:
+            return true;
+        default:
