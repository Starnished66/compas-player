+/*--- Scroll blit (see lv_refr.h) ---*/
+#include "../widgets/label/lv_label.h"
+#include "../widgets/image/lv_image.h"
+#include "../widgets/button/lv_button.h"
+#include "../misc/lv_event_private.h"
+#ifdef UI_PERF_TRACE
+#include <stdio.h>
+#endif
+
+#define SB_OPTIN_MAX 8
+#define SB_OWN_MAX 12
+#define SB_INV_MAX 16 /*A frame that already queued this many areas is busy enough to just redraw the list*/
+enum { /*Outcome codes, also reported to the UI trace. The order is part of the trace format
+        *(see ui_draw_trace.c and draw_summary.py): append only.*/
+    SB_BLIT = 0, SB_COVERED, SB_NET_ZERO, SB_GATE, SB_MODE, SB_OVERLAP, SB_STYLE, SB_STALE, SB_TOO_BIG,
+    SB_FOREIGN /*Something else invalidated part of the list this frame*/
+};
+static struct {
+    lv_obj_t * optin[SB_OPTIN_MAX];
+    lv_scroll_blit_gate_cb_t gate;
+    lv_obj_t * obj;          /*Pending request: scrolled since the last refresh*/
+    lv_display_t * disp;
+    lv_area_t rect;          /*Visible rectangle of `obj` when the request started*/
+    int32_t dy;              /*Net distance the content moved*/
+    bool poisoned;           /*Invalidation state was lost or disabled meanwhile: redraw it all*/
+    bool foreign_pending;    /*Something else invalidated part of the list since the last scroll step*/
+    bool done;               /*The copy ran this refresh: its rect still has to be synced next frame*/
+    lv_area_t done_rect;
+    lv_area_t own[SB_OWN_MAX]; /*Areas this feature invalidated itself (strips, scrollbar column)*/
+    int own_n;
+} sb;
+
+/*Overlays found by the last scan*/
+#ifdef UI_PERF_TRACE
+/*The last copied frame, for the trace's self-check*/
+static lv_obj_t * sb_last_obj;
+static lv_area_t sb_last_rect;
+static lv_area_t sb_last_excl[1]; /*The scrollbar column*/
+static int sb_last_excl_n;
+bool lv_refr_scroll_blit_last(lv_obj_t ** obj, lv_area_t * rect, lv_area_t * excl, int max, int * excl_n)
+{
+    if(!sb_last_obj) return false;
+    *obj = sb_last_obj;
+    *rect = sb_last_rect;
+    *excl_n = LV_MIN(sb_last_excl_n, max);
+    for(int i = 0; i < *excl_n; i++) excl[i] = sb_last_excl[i];
+    return true;
+}
+#endif
+
+void lv_scroll_blit_set_gate(lv_scroll_blit_gate_cb_t gate)
+{
+    sb.gate = gate;
+}
+
+static void sb_delete_cb(lv_event_t * e)
+{
+    lv_obj_t * o = lv_event_get_target(e);
+#ifdef UI_PERF_TRACE
+    if(sb_last_obj == o) sb_last_obj = NULL;
+#endif
+    for(int i = 0; i < SB_OPTIN_MAX; i++) if(sb.optin[i] == o) sb.optin[i] = NULL;
+    if(sb.obj == o) sb.obj = NULL;
+}
+
+static bool sb_optin(lv_obj_t * obj)
+{
+    for(int i = 0; i < SB_OPTIN_MAX; i++) if(sb.optin[i] == obj) return true;
+    return false;
+}
+
+void lv_obj_set_scroll_blit(lv_obj_t * obj, bool en)
+{
+    if(!en) {
+        for(int i = 0; i < SB_OPTIN_MAX; i++) if(sb.optin[i] == obj) sb.optin[i] = NULL;
+        return;
+    }
+    if(sb_optin(obj)) return;
+    for(int i = 0; i < SB_OPTIN_MAX; i++) {
+        if(sb.optin[i]) continue;
+        sb.optin[i] = obj;
+        lv_obj_remove_event_cb(obj, sb_delete_cb); /*Never twice*/
+        lv_obj_add_event_cb(obj, sb_delete_cb, LV_EVENT_DELETE, NULL);
+        return;
+    }
+    LV_LOG_WARN("scroll blit: too many lists, this one scrolls the normal way");
+}
+
+#ifdef UI_PERF_TRACE
+#include <unistd.h>
+static uint32_t sb_guard_counts[LV_SB_GUARD_COUNT];
+void lv_refr_scroll_blit_guard_counts(uint32_t * out)
+{
+    for(int i = 0; i < LV_SB_GUARD_COUNT; i++) out[i] = sb_guard_counts[i];
+}
+void lv_refr_scroll_blit_guard_reset_counts(void)
+{
+    for(int i = 0; i < LV_SB_GUARD_COUNT; i++) sb_guard_counts[i] = 0;
+}
+#endif
+
+void lv_refr_scroll_blit_poison(lv_scroll_blit_guard_t why)
+{
+    if(!sb.obj) return;
+    sb.poisoned = true;
+#ifdef UI_PERF_TRACE
+    if((int) why >= 0 && why < LV_SB_GUARD_COUNT) sb_guard_counts[why]++;
+#endif
+    LV_UNUSED(why);
+}
+
+void lv_refr_scroll_blit_reset(void)
+{
+    lv_refr_scroll_blit_poison(LV_SB_GUARD_RESET);
+}
+
+static bool sb_visible_rect(lv_display_t * disp, lv_obj_t * obj, lv_area_t * rect);
+
+static void sb_report(int code, int32_t dy, uint64_t t0)
+{
+#ifdef UI_PERF_TRACE
+    uint32_t us = t0 ? (uint32_t)(refr_trace_now_us() - t0) : 0;
+    ui_frame_trace_event(UI_FRAME_TRACE_EVENT_SCROLL_BLIT, (uint32_t) code,
+                         ((uint32_t)(dy & 0xffff) << 16) | (us > 0xffff ? 0xffff : us));
+#else
+    LV_UNUSED(code); LV_UNUSED(dy); LV_UNUSED(t0);
+#endif
+}
+
+/*Gives up on the copy: the whole rectangle is redrawn, exactly as an unmodified scroll would*/
+static void sb_cancel(int code)
+{
+    if(!sb.obj) return;
+    sb_report(code, sb.dy, 0);
+    lv_inv_area(sb.disp, &sb.rect);
+    sb.obj = NULL;
+}
+
+static bool sb_display_ok(lv_display_t * disp)
+{
+    return lv_display_is_double_buffered(disp) && !disp->buf_3 &&
+           disp->render_mode == LV_DISPLAY_RENDER_MODE_DIRECT &&
+           lv_display_get_rotation(disp) == LV_DISPLAY_ROTATION_0 &&
+           !lv_display_get_matrix_rotation(disp) && disp->buf_1 && disp->buf_2 &&
+           disp->buf_1->header.stride == disp->buf_2->header.stride;
+}
+
+/*Visible part of the object: its area clipped by the display and by every ancestor*/
+static bool sb_visible_rect(lv_display_t * disp, lv_obj_t * obj, lv_area_t * rect)
+{
+    lv_area_t r = {0, 0, lv_display_get_horizontal_resolution(disp) - 1, lv_display_get_vertical_resolution(disp) - 1};
+    for(lv_obj_t * o = obj; o; o = lv_obj_get_parent(o))
+        if(!lv_area_intersect(&r, &r, &o->coords)) return false;
+    *rect = r;
+    return true;
+}
+
+/*Columns the scrollbar can occupy, from its style, so it does not matter whether it is shown now.
+ *False if the object never draws one.*/
+static bool sb_scrollbar_col(lv_obj_t * obj, int32_t * x1, int32_t * x2)
+{
+    if(!lv_obj_has_flag(obj, LV_OBJ_FLAG_SCROLLABLE) || lv_obj_get_scrollbar_mode(obj) == LV_SCROLLBAR_MODE_OFF)
+        return false;
+    int32_t thickness = lv_obj_get_style_width(obj, LV_PART_SCROLLBAR);
+    if(lv_obj_get_style_base_dir(obj, LV_PART_SCROLLBAR) == LV_BASE_DIR_RTL) {
+        *x1 = obj->coords.x1 + lv_obj_get_style_pad_left(obj, LV_PART_SCROLLBAR);
+        *x2 = *x1 + thickness - 1;
+    }
+    else {
+        *x2 = obj->coords.x2 - lv_obj_get_style_pad_right(obj, LV_PART_SCROLLBAR);
+        *x1 = *x2 - thickness + 1;
+    }
+    *x1 -= 1; /*Rounded ends*/
+    *x2 += 1;
+    return true;
+}
+
+static bool sb_refusal_reported;
+
+#ifdef UI_PERF_TRACE
+static bool sb_diag_armed = true;
+void lv_scroll_blit_diag_reset(void)
+{
+    sb_diag_armed = true;
+    sb_refusal_reported = false;
+}
+/*Names the first object that stopped a blit in this capture*/
+static void sb_diag(const char * why, const lv_obj_t * o)
+{
+    if(!sb_diag_armed || !o) return;
+    sb_diag_armed = false;
+    const lv_obj_class_t * c = o->class_p;
+    const char * kind = c == &lv_obj_class ? "obj" : c == &lv_label_class ? "label" :
+                        c == &lv_image_class ? "image" : c == &lv_button_class ? "button" : "other";
+    printf("[SB_DIAG] %s: %s class=%p coords=(%d,%d)-(%d,%d) ext=%d bg_opa=%d border=%d hidden=%d\n", why, kind,
+           (const void *) c, (int) o->coords.x1, (int) o->coords.y1, (int) o->coords.x2, (int) o->coords.y2,
+           (int) lv_obj_get_ext_draw_size(o), (int) lv_obj_get_style_bg_opa(o, LV_PART_MAIN),
+           (int) lv_obj_get_style_border_width(o, LV_PART_MAIN), (int) lv_obj_has_flag(o, LV_OBJ_FLAG_HIDDEN));
+}
+#else
+#define sb_diag(why, o) LV_UNUSED(o)
+#endif
+
+/*Event handlers that draw into the object's area*/
+static bool sb_has_draw_events(lv_obj_t * o)
+{
+    uint32_t n = lv_obj_get_event_count(o);
+    for(uint32_t i = 0; i < n; i++) {
+        uint32_t code = lv_obj_get_event_dsc(o, i)->filter & ~(uint32_t) LV_EVENT_PREPROCESS;
+        /*LV_EVENT_ALL (0) handlers may draw too*/
+        if(code == LV_EVENT_ALL || (code >= LV_EVENT_DRAW_MAIN_BEGIN && code <= LV_EVENT_DRAW_TASK_ADDED)) return true;
+    }
+    return false;
+}
+
+static bool sb_scrollbar_visible(lv_obj_t * o)
+{
+    lv_area_t h, v;
+    lv_obj_get_scrollbar_area(o, &h, &v);
+    return (h.x2 >= h.x1 && h.y2 >= h.y1) || (v.x2 >= v.x1 && v.y2 >= v.y1);
+}
+
+/*True when the object draws something of its own (not just its children)*/
+static bool sb_draws_itself(lv_obj_t * o)
+{
+    if(lv_obj_get_style_bg_opa(o, LV_PART_MAIN) > LV_OPA_TRANSP ||
+       lv_obj_get_style_border_width(o, LV_PART_MAIN) > 0 ||
+       lv_obj_get_style_outline_width(o, LV_PART_MAIN) > 0 ||
+       lv_obj_get_style_shadow_width(o, LV_PART_MAIN) > 0 ||
+       lv_obj_get_style_bg_image_src(o, LV_PART_MAIN) ||
+       sb_has_draw_events(o) || sb_scrollbar_visible(o)) return true;
+    const lv_obj_class_t * c = o->class_p;
+    if(c == &lv_obj_class || c == &lv_button_class) return false;
+    if(c == &lv_label_class) {
+        const char * text = lv_label_get_text(o);
+        return text && text[0] != '\0';
+    }
+    if(c == &lv_image_class) return lv_image_get_src(o) != NULL;
+    return true;
+}
+
+/*Fails if any visible object outside the list draws something inside `rect`: such pixels would be
+ *carried along by the copy. Fully transparent objects draw nothing and are skipped, their
+ *children are still examined. Layers and overflow-visible objects cannot be bounded and fail too.*/
+static bool sb_collect(lv_obj_t * o, const lv_area_t * rect, lv_obj_t * skip)
+{
+    if(o == skip || lv_obj_has_flag(o, LV_OBJ_FLAG_HIDDEN)) return true;
+    lv_area_t a = o->coords, hit;
+    int32_t ext = lv_obj_get_ext_draw_size(o);
+    lv_area_increase(&a, ext, ext);
+    if(!lv_area_intersect(&hit, &a, rect)) return true;
+    uint32_t n = lv_obj_get_child_count(o);
+    if(lv_obj_get_layer_type(o) != LV_LAYER_TYPE_NONE ||
+       (n && lv_obj_has_flag(o, LV_OBJ_FLAG_OVERFLOW_VISIBLE))) { sb_diag("layer/overflow overlay", o); return false; }
+    if(sb_draws_itself(o)) { sb_diag("overlay over the list", o); return false; }
+    for(uint32_t i = 0; i < n; i++)
+        if(!sb_collect(lv_obj_get_child(o, i), rect, skip)) return false;
+    return true;
+}
+
+/*Descendants of the list must render the same wherever they are: no layers*/
+static bool sb_no_layers_below(lv_obj_t * o)
+{
+    uint32_t n = lv_obj_get_child_count(o);
+    for(uint32_t i = 0; i < n; i++) {
+        lv_obj_t * c = lv_obj_get_child(o, i);
+        if(lv_obj_get_layer_type(c) != LV_LAYER_TYPE_NONE) { sb_diag("list descendant layer", c); return false; }
+        if(!sb_no_layers_below(c)) return false;
+    }
+    return true;
+}
+
+/*Everything that must hold for the copy to be exact; false with the reason in `code`*/
+static bool sb_scan(lv_display_t * disp, lv_obj_t * obj, const lv_area_t * rect, int * code)
+{
+    /*The object itself only draws its children and the scrollbar*/
+    int32_t cx1, cx2;
+    bool has_bar = sb_scrollbar_col(obj, &cx1, &cx2);
+    bool bar_style_ok = !has_bar ||
+        (lv_obj_get_style_shadow_width(obj, LV_PART_SCROLLBAR) == 0 &&
+         lv_obj_get_style_outline_width(obj, LV_PART_SCROLLBAR) == 0 &&
+         lv_obj_get_style_border_width(obj, LV_PART_SCROLLBAR) == 0);
+    if(lv_obj_get_style_bg_opa(obj, LV_PART_MAIN) > LV_OPA_TRANSP ||
+       lv_obj_get_style_border_width(obj, LV_PART_MAIN) > 0 ||
+       lv_obj_get_style_outline_width(obj, LV_PART_MAIN) > 0 ||
+       lv_obj_get_style_shadow_width(obj, LV_PART_MAIN) > 0 ||
+       lv_obj_get_style_bg_image_src(obj, LV_PART_MAIN) || sb_has_draw_events(obj) || !bar_style_ok ||
+       lv_obj_get_ext_draw_size(obj) != 0 || lv_obj_has_flag(obj, LV_OBJ_FLAG_OVERFLOW_VISIBLE) ||
+       (lv_obj_get_scroll_dir(obj) & LV_DIR_HOR)) { sb_diag("list style", obj); *code = SB_STYLE; return false; }
+    uint32_t n = lv_obj_get_child_count(obj);
+    for(uint32_t i = 0; i < n; i++)
+        if(lv_obj_has_flag(lv_obj_get_child(obj, i), LV_OBJ_FLAG_FLOATING)) {
+            sb_diag("floating child", lv_obj_get_child(obj, i)); *code = SB_STYLE; return false;
+        }
+    if(!sb_no_layers_below(obj)) { *code = SB_STYLE; return false; }
+
+    /*Everything behind the object must look the same at any vertical offset*/
+    for(lv_obj_t * o = obj; o; o = lv_obj_get_parent(o)) {
+        if(lv_obj_get_layer_type(o) != LV_LAYER_TYPE_NONE || lv_obj_get_style_clip_corner(o, LV_PART_MAIN) ||
+           (o != obj && lv_obj_has_flag(o, LV_OBJ_FLAG_OVERFLOW_VISIBLE))) {
+            sb_diag("layer/clip", o); *code = SB_STYLE; return false;
+        }
+        lv_obj_t * parent = lv_obj_get_parent(o);
+        if(!parent) break;
+        lv_area_t bar_h, bar_v, hit;
+        lv_obj_get_scrollbar_area(parent, &bar_h, &bar_v);
+        if(parent->class_p != &lv_obj_class || /*Other widgets draw more than their style*/
+           lv_obj_get_style_bg_grad_dir(parent, LV_PART_MAIN) != LV_GRAD_DIR_NONE ||
+           lv_obj_get_style_bg_image_src(parent, LV_PART_MAIN) ||
+           lv_obj_get_style_border_width(parent, LV_PART_MAIN) > 0 ||
+           lv_obj_get_style_outline_width(parent, LV_PART_MAIN) > 0 ||
+           lv_obj_get_style_shadow_width(parent, LV_PART_MAIN) > 0 ||
+           (lv_obj_get_style_radius(parent, LV_PART_MAIN) > 0 && lv_obj_get_style_bg_opa(parent, LV_PART_MAIN) > LV_OPA_TRANSP) ||
+           sb_has_draw_events(parent) ||
+           lv_area_intersect(&hit, &bar_h, rect) || lv_area_intersect(&hit, &bar_v, rect)) {
+            sb_diag("ancestor style", parent); *code = SB_STYLE; return false;
+        }
+        uint32_t pn = lv_obj_get_child_count(parent);
+        for(uint32_t i = 0; i < pn; i++)
+            if(!sb_collect(lv_obj_get_child(parent, i), rect, o)) { *code = SB_OVERLAP; return false; }
+    }
+    lv_obj_t * layers[3] = {lv_display_get_layer_bottom(disp), lv_display_get_layer_top(disp), lv_display_get_layer_sys(disp)};
+    for(int l = 0; l < 3; l++) {
+        uint32_t ln = lv_obj_get_child_count(layers[l]);
+        for(uint32_t i = 0; i < ln; i++)
+            if(!sb_collect(lv_obj_get_child(layers[l], i), rect, NULL)) { *code = SB_OVERLAP; return false; }
+    }
+    return true;
+}
+
+#ifdef UI_PERF_TRACE
+/* Stress test: while /usr/data/mnt/sd_0/compas_scroll_blit.stress exists, now and then queue an
+ * invalid area on the edge rows a scroll step is about to expose, as an animation running just
+ * before the scroll would. The rules above must turn those frames into whole-list redraws;
+ * the self-check shows whether they do. */
+static void sb_stress(lv_display_t * disp, lv_obj_t * obj, int32_t dy)
+{
+    static uint32_t checked_at, rng = 12345u;
+    static bool checked, on;
+    if(!checked || lv_tick_elaps(checked_at) >= 500) {
+        on = access("/usr/data/mnt/sd_0/compas_scroll_blit.stress", F_OK) == 0;
+        checked_at = lv_tick_get();
+        checked = true;
+    }
+    if(!on) return;
+    rng = rng * 1664525u + 1013904223u;
+    if((rng >> 24) % 4 != 0) return;
+    lv_area_t rect;
+    if(!sb_visible_rect(disp, obj, &rect)) return;
+    int32_t rows = LV_MAX(1, LV_MIN(dy > 0 ? dy : -dy, 4));
+    if(dy > 0) rect.y2 = LV_MIN(rect.y1 + rows - 1, rect.y2);
+    else rect.y1 = LV_MAX(rect.y2 - rows + 1, rect.y1);
+    sb_guard_counts[LV_SB_GUARD_STRESS]++;
+    lv_inv_area(disp, &rect);
+}
+#endif
+
+bool lv_refr_scroll_blit_begin(lv_obj_t * obj, int32_t dy)
+{
+    if(!sb.gate || !sb_optin(obj)) return false;
+    lv_display_t * disp = lv_obj_get_display(obj);
+    if(!disp) return false;
+    if(!lv_display_is_invalidation_enabled(disp)) { /*Nothing recorded now: a pending copy would lack it*/
+        lv_refr_scroll_blit_poison(LV_SB_GUARD_INVAL_DISABLED);
+        return false;
+    }
+    if(sb.obj && sb.obj != obj) sb_cancel(SB_STALE);
+#ifdef UI_PERF_TRACE
+    sb_stress(disp, obj, dy);
+#endif
+
+    lv_area_t rect;
+    int32_t net = (sb.obj == obj ? sb.dy : 0) + dy;
+    int code = SB_BLIT;
+    if(!sb_display_ok(disp)) code = SB_MODE;
+    else if(lv_obj_get_screen(obj) != lv_display_get_screen_active(disp) ||
+            !sb_visible_rect(disp, obj, &rect) || lv_area_get_height(&rect) <= 0) code = SB_STALE;
+    else if(net >= lv_area_get_height(&rect) / 2 || -net >= lv_area_get_height(&rect) / 2) code = SB_TOO_BIG;
+    else if(sb.obj == obj && !lv_area_is_equal(&sb.rect, &rect)) code = SB_STALE;
+    else if(disp->inv_p > SB_INV_MAX) code = SB_OVERLAP;
+    bool first = sb.obj != obj;
+    if(code == SB_BLIT) {
+        /*Another invalidation that touches the list was recorded before this step moved the content,
+         *so it describes where things were: nothing the copy does would redraw what it left behind.
+         *For the first step that is anything already queued over the list; later it is whatever
+         *arrived since the previous step.*/
+        bool foreign = !first && sb.foreign_pending;
+        for(uint16_t i = 0; first && i < disp->inv_p && !foreign; i++) {
+            lv_area_t hit;
+            foreign = lv_area_intersect(&hit, &disp->inv_areas[i], &rect);
+        }
+        if(foreign) {
+            code = SB_FOREIGN;
+#ifdef UI_PERF_TRACE
+            sb_guard_counts[LV_SB_GUARD_FOREIGN]++;
+#endif
+        }
+    }
+    if(code == SB_BLIT && first) { /*Overlays now are what the on-screen page shows over the list*/
+        sb_scan(disp, obj, &rect, &code); /*Refuses while any overlay touches the list*/
+    }
+    if(code != SB_BLIT) {
+        if(!sb_refusal_reported) sb_report(code, net, 0); /*Once per capture: a refusal repeats every frame*/
+        sb_refusal_reported = true;
+        if(sb.obj == obj) sb_cancel(code);
+        return false;
+    }
+
+    if(first) {
+        sb.poisoned = false;
+        sb.own_n = 0;
+        sb.foreign_pending = false;
+    }
+    sb.obj = obj;
+    sb.disp = disp;
+    sb.rect = rect;
+    sb.dy = net;
+    return true;
+}
+
+static bool sb_in_own; /*lv_inv_area() is being called by this feature itself*/
+
+void lv_refr_scroll_blit_note_inval(const lv_area_t * area)
+{
+    lv_area_t hit;
+    if(!sb.obj || sb_in_own || !lv_area_intersect(&hit, area, &sb.rect)) return;
+    sb.foreign_pending = true;
+}
+
+/*Invalidates an area on this feature's behalf and remembers it: at refresh time any other
+ *invalid area inside the list means the exact pixel model is unknown, and the list is redrawn.*/
+static void sb_own(const lv_area_t * a)
+{
+    sb_in_own = true;
+    lv_inv_area(sb.disp, a);
+    sb_in_own = false;
+    if(sb.own_n < SB_OWN_MAX) sb.own[sb.own_n++] = *a;
+    else lv_refr_scroll_blit_poison(LV_SB_GUARD_OWN_OVERFLOW);
+}
+
+void lv_refr_scroll_blit_end(lv_obj_t * obj, int32_t dy)
+{
+    if(sb.obj != obj) return;
+    sb.foreign_pending = false; /*Nothing can have been invalidated between begin and here*/
+    lv_area_t a = sb.rect;
+    if(dy > 0) a.y2 = LV_MIN(a.y1 + dy - 1, a.y2);
+    else a.y1 = LV_MAX(a.y2 + dy + 1, a.y1);
+    sb_own(&a);
+
+    /*The scrollbar does not move with the content: redraw its column*/
+    int32_t x1, x2;
+    if(sb_scrollbar_col(obj, &x1, &x2)) {
+        lv_area_t col = {LV_MAX(x1, sb.rect.x1), sb.rect.y1, LV_MIN(x2, sb.rect.x2), sb.rect.y2};
+        if(col.x1 <= col.x2) sb_own(&col);
+    }
+}
+
+/*Removes `rect` from the areas waiting to be copied to the off-screen page*/
+static void sb_carve_sync(const lv_area_t * rect)
+{
+    lv_area_t res[4];
+    lv_area_t * sync_area = lv_ll_get_head(&disp_refr->sync_areas);
+    while(sync_area) {
+        lv_area_t * next = lv_ll_get_next(&disp_refr->sync_areas, sync_area);
+        int8_t n = lv_area_diff(res, sync_area, rect);
+        if(n != -1) {
+            for(int8_t j = 0; j < n; j++) {
+                lv_area_t * piece = lv_ll_ins_prev(&disp_refr->sync_areas, sync_area);
+                *piece = res[j];
+            }
+            lv_ll_remove(&disp_refr->sync_areas, sync_area);
+            lv_free(sync_area);
+        }
+        sync_area = next;
+    }
+}
+
+/*Called at the start of a refresh, after layout and before the page sync*/
+static void sb_apply(void)
+{
+    sb.done = false;
+    if(!sb.obj) return;
+    lv_obj_t * obj = sb.obj;
+    lv_display_t * disp = sb.disp;
+    sb.obj = NULL;
+    int code = SB_BLIT;
+    lv_area_t rect = sb.rect, cur;
+    uint64_t t0 = 0;
+    if(sb.poisoned || disp != disp_refr || !sb_display_ok(disp) || disp->inv_p == 0 ||
+       lv_obj_get_screen(obj) != disp->act_scr ||
+       !sb_visible_rect(disp, obj, &cur) || !lv_area_is_equal(&cur, &rect)) code = SB_STALE;
+    else if(sb.dy == 0) code = SB_NET_ZERO;
+    else {
+        for(uint16_t i = 0; i < disp->inv_p; i++)
+            if(lv_area_is_in(&rect, &disp->inv_areas[i], 0)) code = SB_COVERED;
+    }
+    if(code == SB_BLIT) { /*Every invalid area inside the list must be one this feature made*/
+        for(uint16_t i = 0; i < disp->inv_p && code == SB_BLIT; i++) {
+            lv_area_t in_list;
+            if(!lv_area_intersect(&in_list, &disp->inv_areas[i], &rect)) continue;
+            /*The whole area must be ours, not just its part inside the list: an overlay that was on
+             *the panel and goes away invalidates itself, and the rows it covered would be carried
+             *down by the copy while that part looks like a strip row.*/
+            bool mine = false;
+            for(int k = 0; k < sb.own_n && !mine; k++) mine = lv_area_is_in(&disp->inv_areas[i], &sb.own[k], 0);
+            if(!mine) code = SB_FOREIGN;
+        }
+    }
+    if(code == SB_BLIT) sb_scan(disp, obj, &rect, &code);
+    lv_draw_buf_t * off_screen = disp->buf_act;
+    lv_draw_buf_t * on_screen = off_screen == disp->buf_1 ? disp->buf_2 : disp->buf_1;
+    if(code == SB_BLIT && !sb.gate(disp, obj, on_screen->data)) code = SB_GATE;
+    if(code >= SB_GATE) {
+        sb_report(code, sb.dy, 0);
+        lv_inv_area(disp, &rect);
+        return;
+    }
+    if(code != SB_BLIT) {
+        sb_report(code, sb.dy, 0);
+        return;
+    }
+
+    /*The rows the copy cannot supply: the net strip at the edge the content moved away from*/
+    lv_area_t strip = rect;
+    if(sb.dy > 0) strip.y2 = LV_MIN(rect.y1 + sb.dy - 1, rect.y2);
+    else strip.y1 = LV_MAX(rect.y2 + sb.dy + 1, rect.y1);
+    lv_inv_area(disp, &strip);
+
+    /*The previous frame is on the on-screen page: shift its rows into the off-screen page*/
+#ifdef UI_PERF_TRACE
+    t0 = refr_trace_now_us();
+#endif
+    wait_for_flushing(disp);
+    uint32_t bpp = lv_color_format_get_size(disp->color_format);
+    uint32_t stride = off_screen->header.stride;
+    int32_t dy = sb.dy;
+    int32_t src_y1 = dy > 0 ? rect.y1 : rect.y1 - dy;
+    int32_t src_y2 = dy > 0 ? rect.y2 - dy : rect.y2;
+    int32_t rows = src_y2 - src_y1 + 1;
+    size_t row_bytes = (size_t)(rect.x2 - rect.x1 + 1) * bpp;
+    if(rows > 0) {
+        const uint8_t * src = (const uint8_t *) on_screen->data + (size_t) src_y1 * stride + (size_t) rect.x1 * bpp;
+        uint8_t * dst = (uint8_t *) off_screen->data + (size_t)(src_y1 + dy) * stride + (size_t) rect.x1 * bpp;
+        if(row_bytes == stride) lv_memcpy(dst, src, row_bytes * (size_t) rows);
+        else for(int32_t r = 0; r < rows; r++) lv_memcpy(dst + (size_t) r * stride, src + (size_t) r * stride, row_bytes);
+    }
+    sb_carve_sync(&rect);
+    sb.done = true;
+    sb.done_rect = rect;
+#ifdef UI_PERF_TRACE
+    sb_last_obj = obj;
+    sb_last_rect = rect;
+    sb_last_excl_n = 0;
+    int32_t cx1, cx2;
+    if(sb_scrollbar_col(obj, &cx1, &cx2)) {
+        lv_area_t col = {cx1, rect.y1, cx2, rect.y2};
+        sb_last_excl[sb_last_excl_n++] = col;
+    }
+#endif
+    sb_report(SB_BLIT, dy, t0);
+}
