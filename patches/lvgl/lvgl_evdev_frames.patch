+bool lv_evdev_discard_pending(lv_indev_t * indev)
+{
+    if(indev == NULL) return false;
+
+    lv_evdev_t * dsc = lv_indev_get_driver_data(indev);
+    if(dsc == NULL || dsc->deleting) return false;
+
+    /* Reuse the driver's parser and frame boundaries, but do not dispatch the
+     * resulting samples through LVGL while a callback is still unwinding. */
+    lv_indev_data_t discarded;
+    do {
+        memset(&discarded, 0, sizeof(discarded));
+        _evdev_read(indev, &discarded);
+    } while(discarded.continue_reading);
+
+    /* A non-terminated frame can leave parser state behind after EAGAIN. It
+     * belongs to the external session too, so drop that partial frame. */
+    dsc->frame_count = 0;
+    dsc->frame_type_a = false;
+    dsc->frame_up = false;
+    dsc->slotted = false;
+    dsc->frame_lost = false;
+    dsc->pending_has_x = dsc->pending_has_y = dsc->pending_has_id = false;
+    dsc->dropping = false;
+
+    bool held = dsc->state == LV_INDEV_STATE_PRESSED;
+    unsigned long keys[(KEY_MAX + sizeof(unsigned long) * 8) / (sizeof(unsigned long) * 8)] = { 0 };
+    if(ioctl(dsc->fd, EVIOCGKEY(sizeof(keys)), keys) >= 0) {
+        const unsigned bits_per_word = (unsigned)(sizeof(unsigned long) * 8);
+        held = (keys[BTN_TOUCH / bits_per_word] & (1UL << (BTN_TOUCH % bits_per_word))) != 0;
+    }
+
+    dsc->state = held ? LV_INDEV_STATE_PRESSED : LV_INDEV_STATE_RELEASED;
+    dsc->follow_valid = false;
+    dsc->ignoring = false;
+    dsc->follow_missed = 0;
+    if(held) lv_indev_wait_release(indev);
+    return held;
+}
