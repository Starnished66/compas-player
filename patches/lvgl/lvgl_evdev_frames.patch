+static void _evdev_frame_contact_end(lv_evdev_t * dsc)
+{
+    dsc->frame_type_a = true;
+    /* A contact with tracking ID -1 is a lift, not a finger on the panel. */
+    bool lifted = dsc->pending_has_id && dsc->pending_id < 0;
+    if(!lifted && dsc->pending_has_x && dsc->pending_has_y && dsc->frame_count < MAX_FRAME_CONTACTS) {
+        dsc->frame_contacts[dsc->frame_count].x = dsc->pending_x;
+        dsc->frame_contacts[dsc->frame_count].y = dsc->pending_y;
+        dsc->frame_contacts[dsc->frame_count].id = dsc->pending_id;
+        dsc->frame_contacts[dsc->frame_count].has_id = dsc->pending_has_id;
+        dsc->frame_count++;
+    }
+    dsc->pending_has_x = dsc->pending_has_y = dsc->pending_has_id = false;
+}
+
+/* Resolve one type A frame so the pointer follows exactly one finger. The
+ * linux input events already set root_x/root_y/state for the last contact of
+ * the frame; this puts back the followed finger. Type B, single-touch and
+ * frames without contacts are left as they are. */
+static void _evdev_follow_frame(lv_evdev_t * dsc)
+{
+    uint8_t count = dsc->frame_count;
+    bool type_a = dsc->frame_type_a;
+    bool up = dsc->frame_up;
+    bool slotted = dsc->slotted;
+    bool lost = dsc->frame_lost;
+    dsc->frame_count = 0;
+    dsc->frame_type_a = false;
+    dsc->frame_up = false;
+    dsc->slotted = false;
+    dsc->frame_lost = false;
+    dsc->pending_has_x = dsc->pending_has_y = dsc->pending_has_id = false;
+
+    if(up) {
+        dsc->follow_valid = false;
+        dsc->ignoring = false;
+    }
+    if(slotted || !type_a || up) return;
+
+    /* The -1 handling in _evdev_read released the pointer; while follow owns
+     * the frame a lift is only a miss for the followed finger. */
+    if(lost) dsc->state = dsc->frame_state;
+    if(count == 0 && (!lost || !dsc->follow_valid)) return;
+
+    if(dsc->ignoring) {
+        dsc->state = LV_INDEV_STATE_RELEASED;
+        dsc->root_x = dsc->follow_x;
+        dsc->root_y = dsc->follow_y;
+        return;
+    }
+
+    int sel = -1;
+    if(count == 0) {
+        /* Only lifts in this frame: the followed finger counts as missing. */
+    }
+    else if(!dsc->follow_valid) {
+        sel = 0;
+        dsc->follow_valid = true;
+        dsc->follow_has_id = dsc->frame_contacts[0].has_id;
+        dsc->follow_id = dsc->frame_contacts[0].id;
+        dsc->follow_missed = 0;
+    }
+    else if(dsc->follow_has_id) {
+        for(int i = 0; i < count; i++) {
+            if(dsc->frame_contacts[i].has_id && dsc->frame_contacts[i].id == dsc->follow_id) {
+                sel = i;
+                break;
+            }
+        }
+    }
+    else if(count == 1) {
+        sel = 0;
+    }
+    else {
+        int64_t best = (int64_t)FOLLOW_MAX_JUMP * FOLLOW_MAX_JUMP;
+        for(int i = 0; i < count; i++) {
+            int64_t dx = dsc->frame_contacts[i].x - dsc->follow_x;
+            int64_t dy = dsc->frame_contacts[i].y - dsc->follow_y;
+            int64_t d = dx * dx + dy * dy;
+            if(d <= best) {
+                best = d;
+                sel = i;
+            }
+        }
+    }
+
+    if(sel >= 0) {
+        dsc->follow_x = dsc->frame_contacts[sel].x;
+        dsc->follow_y = dsc->frame_contacts[sel].y;
+        dsc->follow_missed = 0;
+        dsc->state = LV_INDEV_STATE_PRESSED;
+    }
+    else if(++dsc->follow_missed >= FOLLOW_MAX_MISSED_FRAMES) {
+        dsc->follow_valid = false;
+        dsc->ignoring = true;
+        dsc->state = LV_INDEV_STATE_RELEASED;
+    }
+    /* A frame without the followed finger keeps the previous position. */
+    dsc->root_x = dsc->follow_x;
+    dsc->root_y = dsc->follow_y;
+}
