+static bool ram_stage_matches_display(lv_display_t * disp, const lv_linux_fb_t * dsc)
+{
+    return disp && dsc && dsc->ram_stage_buf && dsc->ram_stage_valid &&
+           dsc->ram_stage_width == dsc->vinfo.xres && dsc->ram_stage_height == dsc->vinfo.yres &&
+           dsc->ram_stage_rotation == lv_display_get_rotation(disp) &&
+           dsc->ram_stage_width == (uint32_t)lv_display_get_horizontal_resolution(disp) &&
+           dsc->ram_stage_height == (uint32_t)lv_display_get_vertical_resolution(disp);
+}
+
+bool lv_linux_fbdev_last_present_succeeded(lv_display_t * disp)
+{
+    lv_linux_fb_t * dsc = lv_display_get_driver_data(disp);
+    return dsc && dsc->last_present_successful;
+}
