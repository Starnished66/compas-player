+static void res_changed_event_cb(lv_event_t * e)
+{
+    lv_display_t * disp = lv_event_get_target(e);
+    lv_linux_fb_t * dsc = lv_display_get_driver_data(disp);
+    if(!dsc || !dsc->pan_double_buffer) return;
+
+    /* Do not free stage memory or redirect rendering to scanout from this
+     * event callback. The GUI wake timer will end the stage and select the
+     * ordinary buffers once it can safely fall back. */
+    if(dsc->ram_stage_buf) {
+        dsc->ram_stage_valid = false;
+        dsc->ram_stage_ready = false;
+        lv_timer_t * refr_timer = lv_display_get_refr_timer(disp);
+        if(refr_timer) lv_timer_pause(refr_timer);
+        dsc->last_present_successful = false;
+        return;
+    }
+
+    configure_pan_buffers(disp, dsc);
+}
+
+static void configure_pan_buffers(lv_display_t * disp, lv_linux_fb_t * dsc)
+{
+    lv_display_rotation_t rot = lv_display_get_rotation(disp);
+    /* Buffer orientation/mapping changed; require a new successful LVGL flush
+     * before a later wake can retain the current scanout. */
+    dsc->last_present_successful = false;
+    uint32_t draw_buf_size = dsc->vinfo.xres * dsc->vinfo.yres * (dsc->vinfo.bits_per_pixel >> 3);
+
+    /* The flush copies a 180-degree frame by reversing 16-bit pixels, so
+     * only that case leaves the zero-copy page rendering. */
+    if(rot == LV_DISPLAY_ROTATION_180 && dsc->vinfo.bits_per_pixel == 16) {
+        if(!dsc->draw_buf_1) {
+            dsc->draw_buf_1 = lv_malloc(draw_buf_size);
+            LV_ASSERT_MALLOC(dsc->draw_buf_1);
+        }
+        lv_ll_clear(&disp->sync_areas);
+        lv_display_set_buffers(disp, dsc->draw_buf_1, NULL, draw_buf_size, LV_DISPLAY_RENDER_MODE_DIRECT);
+    }
+    else {
+        lv_ll_clear(&disp->sync_areas);
+        lv_display_set_buffers(disp, dsc->page0, dsc->page1, draw_buf_size, LV_DISPLAY_RENDER_MODE_DIRECT);
+        bool page1_active = (dsc->vinfo.yoffset == dsc->page_yoffset);
+        disp->buf_act = page1_active ? disp->buf_1 : disp->buf_2;
+        if(dsc->draw_buf_1) {
+            lv_free(dsc->draw_buf_1);
+            dsc->draw_buf_1 = NULL;
+        }
+    }
+}
