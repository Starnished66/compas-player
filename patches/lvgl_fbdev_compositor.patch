+bool lv_linux_fbdev_begin_ram_stage(lv_display_t * disp)
+{
+#if LV_LINUX_FBDEV_MMAP && !LV_LINUX_FBDEV_BSD
+    if(!disp || disp->flushing || disp->rendering_in_progress) return false;
+    lv_linux_fb_t * dsc = lv_display_get_driver_data(disp);
+    if(!dsc || !dsc->pan_double_buffer || dsc->external_composition_active ||
+       dsc->ram_stage_buf || !dsc->fbp || dsc->fbp == MAP_FAILED || dsc->fbfd < 0 ||
+       dsc->screensize <= 0 || !dsc->page0 || !dsc->page1 ||
+       dsc->vinfo.bits_per_pixel != 16 || lv_display_get_color_format(disp) != LV_COLOR_FORMAT_RGB565 ||
+       dsc->finfo.line_length != (long int)dsc->vinfo.xres * 2 ||
+       lv_draw_buf_width_to_stride(dsc->vinfo.xres, LV_COLOR_FORMAT_RGB565) != (uint64_t)dsc->vinfo.xres * 2 ||
+       dsc->vinfo.xres != (uint32_t)lv_display_get_horizontal_resolution(disp) ||
+       dsc->vinfo.yres != (uint32_t)lv_display_get_vertical_resolution(disp) ||
+       dsc->vinfo.xoffset != 0 ||
+       (dsc->vinfo.yoffset != 0 && dsc->vinfo.yoffset != dsc->page_yoffset) ||
+       (lv_display_get_rotation(disp) != LV_DISPLAY_ROTATION_0 &&
+        lv_display_get_rotation(disp) != LV_DISPLAY_ROTATION_180)) return false;
+
+    if(lv_display_get_rotation(disp) == LV_DISPLAY_ROTATION_180 && !dsc->draw_buf_1) return false;
+
+    if(dsc->vinfo.xres == 0 || dsc->vinfo.yres == 0 || dsc->finfo.line_length <= 0 ||
+       dsc->page_yoffset == 0 ||
+       dsc->vinfo.yres_virtual < dsc->vinfo.yres ||
+       dsc->page_yoffset > dsc->vinfo.yres_virtual - dsc->vinfo.yres ||
+       (size_t)dsc->vinfo.xres > SIZE_MAX / (size_t)dsc->vinfo.yres / 2)
+        return false;
+    size_t size = (size_t)dsc->vinfo.xres * dsc->vinfo.yres * 2;
+    size_t framebuffer_size = (size_t)dsc->screensize;
+    size_t stride = (size_t)dsc->finfo.line_length;
+    if(size == 0 || size > UINT32_MAX || (size & 3u) != 0 ||
+       size > framebuffer_size / 2 || stride > SIZE_MAX / dsc->vinfo.yres ||
+       stride > SIZE_MAX / dsc->page_yoffset)
+        return false;
+    size_t page_bytes = stride * dsc->vinfo.yres;
+    size_t page1_offset = stride * dsc->page_yoffset;
+    if(page_bytes < size || page_bytes > framebuffer_size || page1_offset > framebuffer_size ||
