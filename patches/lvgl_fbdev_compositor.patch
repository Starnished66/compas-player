+bool lv_linux_fbdev_last_frame_reusable(lv_display_t * disp)
+{
+#if LV_LINUX_FBDEV_MMAP && !LV_LINUX_FBDEV_BSD
+    if(!disp) return false;
+    lv_linux_fb_t * dsc = lv_display_get_driver_data(disp);
+    return dsc && dsc->fbfd >= 0 && dsc->fbp && dsc->fbp != MAP_FAILED &&
+           dsc->screensize > 0 && dsc->last_present_successful &&
+           !dsc->ram_stage_buf &&
+           !dsc->external_composition_active && !disp->flushing &&
+           !disp->rendering_in_progress && disp->inv_p == 0;
+#else
+    (void)disp;
+    return false;
+#endif
+}
+
+bool lv_linux_fbdev_clear_scanout(lv_display_t * disp)
+{
+#if LV_LINUX_FBDEV_MMAP && !LV_LINUX_FBDEV_BSD
+    if(!disp) return false;
+    lv_linux_fb_t * dsc = lv_display_get_driver_data(disp);
+    if(!dsc || dsc->fbfd < 0 || !dsc->fbp || dsc->fbp == MAP_FAILED ||
+       dsc->screensize <= 0 || dsc->finfo.smem_len <= 0 ||
+       dsc->external_composition_active || dsc->ram_stage_buf ||
+       disp->flushing || disp->rendering_in_progress)
+        return false;
+
+    /* The mmap spans the complete framebuffer allocation, including every
+     * physical page and its stride padding. Clear all of it so a later
+     * unblank cannot expose a retained pre-wake page. */
+    lv_memzero(dsc->fbp, (size_t)dsc->screensize);
+    dsc->last_present_successful = false;
+    return true;
+#else
+    (void)disp;
+    return false;
+#endif
+}
