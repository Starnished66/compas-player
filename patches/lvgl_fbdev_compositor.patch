+bool lv_linux_fbdev_end_ram_stage(lv_display_t * disp)
+{
+    if(!disp) return false;
+    lv_linux_fb_t * dsc = lv_display_get_driver_data(disp);
+    if(!dsc || !dsc->ram_stage_buf) return true;
+    if(disp->flushing || disp->rendering_in_progress) return false;
+
+    /* A resolution/rotation callback may already have restored the regular
+     * buffers. In that case only release the obsolete staging allocation. */
+    if(ram_stage_matches_display(disp, dsc) && dsc->pan_double_buffer) {
+        lv_display_set_buffers(disp, dsc->ram_stage_saved_buf1, dsc->ram_stage_saved_buf2,
+                               dsc->ram_stage_saved_size, dsc->ram_stage_saved_mode);
+        if(dsc->ram_stage_saved_active == 2 && disp->buf_2) disp->buf_act = disp->buf_2;
+        else if(dsc->ram_stage_saved_active == 1 && disp->buf_1) disp->buf_act = disp->buf_1;
+
+        /* DIRECT rendering must target the inactive scanout page after commit. */
+        if(dsc->ram_stage_saved_mode == LV_DISPLAY_RENDER_MODE_DIRECT &&
+           dsc->ram_stage_saved_buf1 == dsc->page0 && dsc->ram_stage_saved_buf2 == dsc->page1)
+            disp->buf_act = dsc->vinfo.yoffset == 0 ? disp->buf_2 : disp->buf_1;
+        else if(dsc->ram_stage_saved_mode == LV_DISPLAY_RENDER_MODE_DIRECT &&
+                dsc->ram_stage_saved_buf1 == dsc->page1 && dsc->ram_stage_saved_buf2 == dsc->page0)
+            disp->buf_act = dsc->vinfo.yoffset == 0 ? disp->buf_1 : disp->buf_2;
+    }
+    else if(dsc->pan_double_buffer) {
+        /* Rotation/resolution changed while staging. Rebuild the regular
+         * buffers now, outside the LVGL event callback, for current geometry. */
+        configure_pan_buffers(disp, dsc);
+    }
+    lv_ll_clear(&disp->sync_areas);
+    lv_free(dsc->ram_stage_buf);
+    dsc->ram_stage_buf = NULL;
+    dsc->ram_stage_size = 0;
+    dsc->ram_stage_valid = false;
+    dsc->ram_stage_ready = false;
+    dsc->ram_stage_saved_buf1 = NULL;
+    dsc->ram_stage_saved_buf2 = NULL;
+    dsc->ram_stage_saved_size = 0;
+    dsc->ram_stage_saved_active = 0;
+    return true;
+}
