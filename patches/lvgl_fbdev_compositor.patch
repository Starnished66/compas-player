+static void rotate_rgb565_180(const uint8_t * src, uint8_t * dst, size_t bytes)
+{
+    const uint32_t * s = (const uint32_t *)src;
+    uint32_t * d = (uint32_t *)(dst + bytes);
+    size_t words = bytes / sizeof(uint32_t);
+    for(size_t i = 0; i < words; i++) {
+        uint32_t w = s[i];
+        *(--d) = (w >> 16) | (w << 16);
+    }
+}
