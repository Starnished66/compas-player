@@ -325,6 +325,19 @@ void lv_image_buf_get_transformed_area(lv_area_t * res, int32_t w, int32_t h, in
         return;
     }
 
+    if(angle == 0) {
+        /*Round geometric edges outward, retaining partially covered edge pixels.*/
+        int64_t left = (int64_t)pivot->x * LV_SCALE_NONE - (int64_t)pivot->x * scale_x;
+        int64_t top = (int64_t)pivot->y * LV_SCALE_NONE - (int64_t)pivot->y * scale_y;
+        int64_t right = left + (int64_t)w * scale_x;
+        int64_t bottom = top + (int64_t)h * scale_y;
+        res->x1 = (int32_t)(left / LV_SCALE_NONE - (left % LV_SCALE_NONE < 0));
+        res->y1 = (int32_t)(top / LV_SCALE_NONE - (top % LV_SCALE_NONE < 0));
+        res->x2 = (int32_t)(right / LV_SCALE_NONE + (right % LV_SCALE_NONE > 0)) - 1;
+        res->y2 = (int32_t)(bottom / LV_SCALE_NONE + (bottom % LV_SCALE_NONE > 0)) - 1;
+        return;
+    }
+
     lv_point_t p[4] = {
         {0, 0},
         {w, 0},
