+                        for(x = 0; x < w; x++) {
+                            r += *pix++;
+                            if(JD_FORMAT != 2) {
+                                g += *pix++;
+                                b += *pix++;
+                            }
+                        }
+                        pix += a;
+                    }
+                    *op++ = (uint8_t)(r >> s);
+                    if(JD_FORMAT != 2) {
+                        *op++ = (uint8_t)(g >> s);
+                        *op++ = (uint8_t)(b >> s);
+                    }
+                }
+            }
+        }
+    }
+    else {    /* 1/8 scaling: one pixel per 8x8 from the block DC. B,G,R to match the full-MCU loop above. */
+        pix = (uint8_t *)jd->workbuf;
+        pc = jd->mcubuf + mx * my;
+        cb = pc[0] - 128;
+        cr = pc[64] - 128;
+        for(iy = 0; iy < my; iy += 8) {
+            py = jd->mcubuf;
+            if(iy == 8) py += 64 * 2;
+            for(ix = 0; ix < mx; ix += 8) {
+                yy = *py;
+                py += 64;
+                if(JD_FORMAT != 2) {
+                    *pix++ = /*B*/ BYTECLIP(yy + ((int)(1.772 * CVACC) * cb) / CVACC);
+                    *pix++ = /*G*/ BYTECLIP(yy - ((int)(0.344 * CVACC) * cb + (int)(0.714 * CVACC) * cr) / CVACC);
+                    *pix++ = /*R*/ BYTECLIP(yy + ((int)(1.402 * CVACC) * cr) / CVACC);
+                }
+                else {
+                    *pix++ = yy;
+                }
+            }
+        }
     }
 
