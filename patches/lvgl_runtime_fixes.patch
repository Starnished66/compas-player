diff --git a/src/core/lv_obj_pos.c b/src/core/lv_obj_pos.c
index 177b0fb..6547d25 100644
--- a/src/core/lv_obj_pos.c
+++ b/src/core/lv_obj_pos.c
@@ -367,6 +367,10 @@ bool lv_obj_is_layout_positioned(const lv_obj_t * obj)
 
 void lv_obj_mark_layout_as_dirty(lv_obj_t * obj)
 {
+    /* Root screens and display layers have no parent. Flag changes can
+     * request layout invalidation for that absent parent. */
+    if(obj == NULL) return;
+
     obj->layout_inv = 1;
 
     /*Mark the screen as dirty too to mark that there is something to do on this screen*/
@@ -1328,6 +1332,16 @@ static lv_result_t obj_invalidate_area_internal(const lv_display_t * disp, const
     lv_result_t res = invalidate_area_core(obj, &area_tmp);
     if(res == LV_RESULT_INVALID) return res;
 
+    /* Every effect is already covered when a queued area redraws the whole
+     * display. Preserve normal invalidation/events, but avoid repeating the
+     * blur propagation tree walks for each animated property. */
+    for(uint32_t i = 0; i < disp->inv_p; i++) {
+        const lv_area_t * dirty = &disp->inv_areas[i];
+        if(dirty->x1 <= 0 && dirty->y1 <= 0 &&
+           dirty->x2 >= lv_display_get_horizontal_resolution(disp) - 1 &&
+           dirty->y2 >= lv_display_get_vertical_resolution(disp) - 1) return res;
+    }
+
     /*If this area is on a blurred widget, invalidate that widget too*/
     blur_walk_data_t blur_walk_data;
     blur_walk_data.requester_obj = obj;
