+static bool transform_rgb565_nearest_interior(lv_draw_task_t * t, const lv_draw_image_dsc_t * draw_dsc,
+                                              const lv_image_decoder_dsc_t * decoder_dsc,
+                                              lv_draw_image_sup_t * sup, const lv_area_t * img_coords,
+                                              const lv_area_t * clipped_img_area)
+{
+    const lv_draw_buf_t * decoded = decoder_dsc->decoded;
+    const lv_image_header_t * header = &decoded->header;
+    int64_t img_w64 = (int64_t)img_coords->x2 - img_coords->x1 + 1;
+    int64_t img_h64 = (int64_t)img_coords->y2 - img_coords->y1 + 1;
+
+    if(header->cf != LV_COLOR_FORMAT_RGB565 || decoded->data == NULL || draw_dsc->tile ||
+       draw_dsc->rotation != 0 ||
+       draw_dsc->scale_x <= 0 ||
+       draw_dsc->scale_y <= 0 ||
+       draw_dsc->opa != LV_OPA_COVER || draw_dsc->blend_mode != LV_BLEND_MODE_NORMAL ||
+       draw_dsc->clip_radius != 0 || draw_dsc->recolor_opa > LV_OPA_MIN ||
+       draw_dsc->colorkey != NULL || draw_dsc->bitmap_mask_src != NULL ||
+       header->w < 3 || header->h < 3 || header->w > 32767 || header->h > 32767 ||
+       img_w64 != header->w || img_h64 != header->h || img_w64 < 3 || img_h64 < 3 ||
+       header->stride < header->w * 2 || header->stride > INT32_MAX || (header->stride & 1) != 0 ||
+       (uint64_t)header->stride * header->h > decoded->data_size) {
+        return false;
+    }
+
+    int64_t relative_x1 = (int64_t)clipped_img_area->x1 - img_coords->x1;
+    int64_t relative_x2 = (int64_t)clipped_img_area->x2 - img_coords->x1;
+    int64_t relative_y1 = (int64_t)clipped_img_area->y1 - img_coords->y1;
+    int64_t relative_y2 = (int64_t)clipped_img_area->y2 - img_coords->y1;
+    if(relative_x1 < INT32_MIN ||
+       relative_x1 > INT32_MAX || relative_x2 < INT32_MIN || relative_x2 > INT32_MAX ||
+       relative_y1 < INT32_MIN || relative_y1 > INT32_MAX ||
+       relative_y2 < INT32_MIN || relative_y2 > INT32_MAX) {
+        return false;
+    }
+    lv_area_t relative_area = {
+        .x1 = (int32_t)relative_x1,
+        .y1 = (int32_t)relative_y1,
+        .x2 = (int32_t)relative_x2,
+        .y2 = (int32_t)relative_y2,
+    };
+
+    lv_area_t interior;
+    if(!lv_draw_sw_transform_rgb565_nearest(&relative_area, decoded->data, (int32_t)header->w,
+                                            (int32_t)header->h, (int32_t)header->stride,
+                                            draw_dsc, NULL, 0, &interior, NULL, 0, 0)) {
+        return false;
+    }
+    if(interior.x2 < interior.x1 || interior.y2 < interior.y1) return false;
+
+    int32_t interior_w = lv_area_get_width(&interior);
+    int32_t interior_h = lv_area_get_height(&interior);
+    uint64_t row_bytes64 = (uint64_t)(uint32_t)interior_w * 2;
+    const uint32_t max_tile_rows = 16;
+    lv_display_t * disp = lv_refr_get_disp_refreshing();
+    uint32_t display_width = disp ? lv_display_get_horizontal_resolution(disp) : 0;
+    uint64_t max_buf_size64 = (uint64_t)display_width * sizeof(uint16_t) * max_tile_rows;
+    if(display_width == 0 || max_buf_size64 > UINT32_MAX) return false;
+    uint32_t max_buf_size = (uint32_t)max_buf_size64;
+    if(interior_w <= 0 || interior_h <= 0 || row_bytes64 > INT32_MAX || row_bytes64 > max_buf_size) {
+        return false;
+    }
+    int32_t tile_h = (int32_t)(max_buf_size / row_bytes64);
+    if(tile_h > interior_h) tile_h = interior_h;
+    if(tile_h > (int32_t)max_tile_rows) tile_h = (int32_t)max_tile_rows;
+    if(tile_h <= 0 || row_bytes64 * (uint32_t)tile_h > UINT32_MAX) return false;
+    uint8_t * tile_buf = lv_malloc((uint32_t)(row_bytes64 * (uint32_t)tile_h));
+    if(tile_buf == NULL) return false;
+    uint64_t x_map_bytes64 = (uint64_t)(uint32_t)interior_w * sizeof(uint32_t);
+    if(x_map_bytes64 > UINT32_MAX) { lv_free(tile_buf); return false; }
+    uint32_t * x_samples = lv_malloc((uint32_t)x_map_bytes64);
+    if(x_samples == NULL) {
+        lv_free(tile_buf);
+        return false;
+    }
+    if(!lv_draw_sw_transform_rgb565_nearest(&relative_area, decoded->data, (int32_t)header->w,
+                                            (int32_t)header->h, (int32_t)header->stride,
+                                            draw_dsc, NULL, 0, &interior,
+                                            x_samples, interior.x1, (uint32_t)interior_w)) {
+        lv_free(x_samples);
+        lv_free(tile_buf);
+        return false;
+    }
+
+    /* Keep the original transform path responsible for every edge pixel. */
+    lv_area_t fallback = *clipped_img_area;
+    if(relative_area.y1 < interior.y1) {
+        fallback.y1 = img_coords->y1 + relative_area.y1;
+        fallback.y2 = img_coords->y1 + interior.y1 - 1;
+        transform_and_recolor(t, draw_dsc, decoder_dsc, sup, img_coords, &fallback);
+    }
+    if(interior.y2 < relative_area.y2) {
+        fallback.y1 = img_coords->y1 + interior.y2 + 1;
+        fallback.y2 = img_coords->y1 + relative_area.y2;
+        transform_and_recolor(t, draw_dsc, decoder_dsc, sup, img_coords, &fallback);
+    }
+    if(relative_area.x1 < interior.x1) {
+        fallback.x1 = img_coords->x1 + relative_area.x1;
+        fallback.x2 = img_coords->x1 + interior.x1 - 1;
+        fallback.y1 = img_coords->y1 + interior.y1;
+        fallback.y2 = img_coords->y1 + interior.y2;
+        transform_and_recolor(t, draw_dsc, decoder_dsc, sup, img_coords, &fallback);
+    }
+    if(interior.x2 < relative_area.x2) {
+        fallback.x1 = img_coords->x1 + interior.x2 + 1;
+        fallback.x2 = img_coords->x1 + relative_area.x2;
+        fallback.y1 = img_coords->y1 + interior.y1;
+        fallback.y2 = img_coords->y1 + interior.y2;
+        transform_and_recolor(t, draw_dsc, decoder_dsc, sup, img_coords, &fallback);
+    }
 
+    lv_area_t tile_area = interior;
+    tile_area.y2 = tile_area.y1 + tile_h - 1;
+    while(tile_area.y1 <= interior.y2) {
+        lv_area_t tile_relative = {
+            .x1 = tile_area.x1,
+            .y1 = tile_area.y1,
+            .x2 = tile_area.x2,
+            .y2 = tile_area.y2,
+        };
+        lv_area_t tile_safe;
+        if(!lv_draw_sw_transform_rgb565_nearest(&tile_relative, decoded->data, (int32_t)header->w,
+                                                (int32_t)header->h, (int32_t)header->stride,
+                                                draw_dsc, (uint16_t *)tile_buf, (int32_t)row_bytes64,
+                                                &tile_safe, x_samples, interior.x1,
+                                                (uint32_t)interior_w)) {
+            /* Fall back for the not-yet-drawn portion if an invariant is violated. */
+            lv_area_t remainder = {
+                .x1 = img_coords->x1 + tile_area.x1,
+                .y1 = img_coords->y1 + tile_area.y1,
+                .x2 = img_coords->x1 + interior.x2,
+                .y2 = img_coords->y1 + interior.y2,
+            };
+            transform_and_recolor(t, draw_dsc, decoder_dsc, sup, img_coords, &remainder);
+            lv_free(x_samples);
+            lv_free(tile_buf);
+            return true;
+        }
+
+        lv_area_t blend_area = tile_area;
+        lv_area_move(&blend_area, img_coords->x1, img_coords->y1);
+        lv_draw_sw_blend_dsc_t blend_dsc;
+        lv_memzero(&blend_dsc, sizeof(blend_dsc));
+        blend_dsc.opa = draw_dsc->opa;
+        blend_dsc.blend_mode = draw_dsc->blend_mode;
+        blend_dsc.src_stride = (int32_t)row_bytes64;
+        blend_dsc.src_area = &blend_area;
+        blend_dsc.blend_area = &blend_area;
+        blend_dsc.src_buf = tile_buf;
+        blend_dsc.src_color_format = LV_COLOR_FORMAT_RGB565;
+        lv_draw_sw_blend(t, &blend_dsc);
+
+        tile_area.y1 = tile_area.y2 + 1;
+        tile_area.y2 = tile_area.y1 + tile_h - 1;
+        if(tile_area.y2 > interior.y2) tile_area.y2 = interior.y2;
     }
+
+    lv_free(x_samples);
+    lv_free(tile_buf);
+    return true;
 }
