+static int64_t floor_divide_i64(int64_t numerator, int32_t denominator)
+{
+    int64_t quotient = numerator / denominator;
+    if(numerator % denominator < 0) quotient--;
+    return quotient;
+}
+
+static sample_axis_t sample_axis_init(int32_t dest, int32_t pivot, int32_t scale)
+{
+    int64_t delta = (int64_t)dest - pivot;
+    int64_t numerator = delta * 65536 + 32768;
+    int64_t quotient = floor_divide_i64(numerator, scale);
+    int64_t remainder = numerator - quotient * scale;
+    sample_axis_t axis = {
+        .coord_q8 = (int32_t)(quotient + (int64_t)pivot * 256),
+        .remainder = (int32_t)remainder,
+        .step_q8 = 65536 / scale,
+        .step_remainder = 65536 % scale,
+        .scale = scale,
+    };
+    return axis;
+}
+
+static void sample_axis_advance(sample_axis_t * axis)
+{
+    axis->coord_q8 += axis->step_q8;
+    axis->remainder += axis->step_remainder;
+    if(axis->remainder >= axis->scale) {
+        axis->coord_q8++;
+        axis->remainder -= axis->scale;
+    }
+}
+
+static bool sample_axis_coord_fits(int32_t dest, int32_t pivot, int32_t scale)
+{
+    int64_t delta = (int64_t)dest - pivot;
+    int64_t numerator = delta * 65536 + 32768;
+    int64_t coordinate = floor_divide_i64(numerator, scale) + (int64_t)pivot * 256;
+    return coordinate >= INT32_MIN && coordinate <= INT32_MAX;
+}
+
+bool lv_draw_sw_transform_rgb565_nearest(const lv_area_t * dest_area, const void * src_buf,
+                                        int32_t src_w, int32_t src_h, int32_t src_stride,
+                                        const lv_draw_image_dsc_t * draw_dsc, uint16_t * dest_buf,
+                                        int32_t dest_stride, lv_area_t * safe_area,
+                                        uint32_t * x_samples, int32_t x_samples_x1, uint32_t x_samples_count)
+{
+    if(dest_area == NULL || src_buf == NULL || draw_dsc == NULL || safe_area == NULL ||
+       src_w < 3 || src_h < 3 || src_w > 32767 || src_h > 32767 ||
+       src_stride < src_w * 2 ||
+       draw_dsc->rotation != 0 ||
+       draw_dsc->scale_x <= 0 ||
+       draw_dsc->scale_y <= 0 ||
+       dest_area->x2 < dest_area->x1 || dest_area->y2 < dest_area->y1) {
+        return false;
+    }
+
+    /* Bound the mapper's signed Q8 state at both ends of each monotonic axis. */
+    if(draw_dsc->pivot.x < -32767 || draw_dsc->pivot.x > 32767 ||
+       draw_dsc->pivot.y < -32767 || draw_dsc->pivot.y > 32767 ||
+       dest_area->x1 < -32767 || dest_area->x2 > 32767 ||
+       dest_area->y1 < -32767 || dest_area->y2 > 32767 || src_stride % 2 != 0 ||
+       !sample_axis_coord_fits(dest_area->x1, draw_dsc->pivot.x, draw_dsc->scale_x) ||
+       !sample_axis_coord_fits(dest_area->x2, draw_dsc->pivot.x, draw_dsc->scale_x) ||
+       !sample_axis_coord_fits(dest_area->y1, draw_dsc->pivot.y, draw_dsc->scale_y) ||
+       !sample_axis_coord_fits(dest_area->y2, draw_dsc->pivot.y, draw_dsc->scale_y)) {
+        return false;
+    }
+
+    /* Rendering consumes an x map prepared before any fallback pixels are drawn. */
+    if(dest_buf != NULL) {
+        int32_t width = lv_area_get_width(dest_area);
+        if(x_samples == NULL || x_samples_x1 != dest_area->x1 ||
+           x_samples_count != (uint32_t)width || dest_stride < width * 2 || (dest_stride & 1) != 0) {
+            return false;
+        }
+        for(uint32_t i = 0; i < x_samples_count; i++) {
+            if((x_samples[i] & 0xFFFFU) < 1 || (x_samples[i] & 0xFFFFU) > (uint32_t)(src_w - 2)) return false;
+        }
+
+        sample_axis_t y_axis = sample_axis_init(dest_area->y1, draw_dsc->pivot.y, draw_dsc->scale_y);
+        int32_t y = dest_area->y1;
+        while(y <= dest_area->y2) {
+            int32_t sample_y = clamp_upscale_sample_q8(y_axis.coord_q8, src_h, false) >> 8;
+            if(sample_y < 1 || sample_y > src_h - 2) return false;
+            if(y == dest_area->y2) break;
+            y++;
+            sample_axis_advance(&y_axis);
+        }
+
+        safe_area->x1 = dest_area->x1;
+        safe_area->y1 = dest_area->y1;
+        safe_area->x2 = dest_area->x2;
+        safe_area->y2 = dest_area->y2;
+        const uint8_t * src = src_buf;
+        y_axis = sample_axis_init(dest_area->y1, draw_dsc->pivot.y, draw_dsc->scale_y);
+        int32_t out_y = 0;
+        for(y = dest_area->y1; y <= dest_area->y2; y++, out_y++) {
+            int32_t sample_y = clamp_upscale_sample_q8(y_axis.coord_q8, src_h, false) >> 8;
+            int32_t y_fract = y_axis.coord_q8 & 0xFF;
+            uint32_t y_weight = y_fract < 0x80 ? (uint32_t)(0x7F - y_fract) * 2U : (uint32_t)(y_fract - 0x80) * 2U;
+            int32_t y_next = y_fract < 0x80 ? -1 : 1;
+            for(uint32_t out_x = 0; out_x < x_samples_count; out_x++) {
+                uint32_t packed = x_samples[out_x];
+                int32_t sx = (int32_t)(packed & 0xFFFFU);
+                int32_t x_weight = (int32_t)(packed >> 16);
+                size_t src_offset = (size_t)(uint32_t)sample_y * (size_t)(uint32_t)src_stride + (size_t)sx * 2;
+                const uint16_t * src_px = (const uint16_t *)(src + src_offset);
+                uint16_t color = src_px[0];
+                if(draw_dsc->antialias) {
+                    uint16_t vert = *(const uint16_t *)((const uint8_t *)src_px + y_next * src_stride);
+                    int32_t x_next = (packed & 0x80000000U) ? 1 : -1;
+                    uint16_t horz = src_px[x_next];
+                    if(color != vert || color != horz) {
+                        uint16_t vertical = lv_color_16_16_mix_internal(vert, color, (lv_opa_t)y_weight);
+                        uint16_t horizontal = lv_color_16_16_mix_internal(horz, color, (lv_opa_t)x_weight);
+                        color = lv_color_16_16_mix_internal(horizontal, vertical, LV_OPA_50);
+                    }
+                }
+                dest_buf[(size_t)out_y * (size_t)(uint32_t)(dest_stride / 2) + out_x] = color;
+            }
+            if(y != dest_area->y2) sample_axis_advance(&y_axis);
+        }
+        return true;
+    }
+
+    sample_axis_t x_axis = sample_axis_init(dest_area->x1, draw_dsc->pivot.x, draw_dsc->scale_x);
+    int32_t first_x = 0;
+    int32_t last_x = -1;
+    int32_t x = dest_area->x1;
+    while(x <= dest_area->x2) {
+        int32_t sample_x = clamp_upscale_sample_q8(x_axis.coord_q8, src_w, false) >> 8;
+        if(sample_x >= 1 && sample_x <= src_w - 2) {
+            if(last_x < first_x) first_x = x;
+            last_x = x;
+        }
+        if(x == dest_area->x2) break;
+        x++;
+        sample_axis_advance(&x_axis);
+    }
+
+    sample_axis_t y_axis = sample_axis_init(dest_area->y1, draw_dsc->pivot.y, draw_dsc->scale_y);
+    int32_t first_y = 0;
+    int32_t last_y = -1;
+    int32_t y = dest_area->y1;
+    while(y <= dest_area->y2) {
+        int32_t sample_y = clamp_upscale_sample_q8(y_axis.coord_q8, src_h, false) >> 8;
+        if(sample_y >= 1 && sample_y <= src_h - 2) {
+            if(last_y < first_y) first_y = y;
+            last_y = y;
+        }
+        if(y == dest_area->y2) break;
+        y++;
+        sample_axis_advance(&y_axis);
+    }
+
+    if(last_x < first_x || last_y < first_y) {
+        safe_area->x1 = 1;
+        safe_area->y1 = 1;
+        safe_area->x2 = 0;
+        safe_area->y2 = 0;
+        return x_samples == NULL || x_samples_count == 0;
+    }
+
+    safe_area->x1 = first_x;
+    safe_area->y1 = first_y;
+    safe_area->x2 = last_x;
+    safe_area->y2 = last_y;
+    if(x_samples == NULL) return true;
+
+    uint32_t safe_width = (uint32_t)lv_area_get_width(safe_area);
+    if(x_samples_count != safe_width) return false;
+    x_axis = sample_axis_init(safe_area->x1, draw_dsc->pivot.x, draw_dsc->scale_x);
+    for(uint32_t i = 0; i < safe_width; i++) {
+        int32_t sample_x = clamp_upscale_sample_q8(x_axis.coord_q8, src_w, false) >> 8;
+        if(sample_x < 1 || sample_x > src_w - 2) return false;
+        int32_t fract = x_axis.coord_q8 & 0xFF;
+        uint32_t weight = fract < 0x80 ? (uint32_t)(0x7F - fract) * 2U : (uint32_t)(fract - 0x80) * 2U;
+        uint32_t direction = fract < 0x80 ? 0U : 0x80000000U;
+        x_samples[i] = (uint32_t)sample_x | (weight << 16) | direction;
+        if(i + 1 < safe_width) sample_axis_advance(&x_axis);
+    }
+    return true;
+}
+
+static int32_t clamp_upscale_sample_q8(int32_t sample_q8, int32_t src_size, bool edge_extend)
+{
+    int64_t source_extent_q8 = (int64_t)src_size * 256;
+    if(edge_extend && sample_q8 >= 0 && (int64_t)sample_q8 < source_extent_q8) {
+        if(sample_q8 < 128) return 128;
+        int64_t last_center_q8 = source_extent_q8 - 128;
+        if((int64_t)sample_q8 > last_center_q8) return (int32_t)last_center_q8;
+    }
+    return sample_q8;
+}
+
+static bool should_fade_missing_sample_edge(const sample_transform_dsc_t * sample_dsc, int32_t sample_index,
+                                            int32_t src_size, int32_t neighbor_offset, int32_t weight, bool x_axis)
+{
+    bool edge_extend = x_axis ? sample_dsc->edge_extend_x : sample_dsc->edge_extend_y;
+    if(edge_extend || (sample_dsc->scale_only && weight == 0)) return false;
+    return (sample_index == 0 && neighbor_offset < 0) ||
+           (sample_index == src_size - 1 && neighbor_offset > 0);
+}
