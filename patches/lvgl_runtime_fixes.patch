+    return published->data && published->data == transform_intermediate_source_data &&
+           published->data_size == transform_intermediate_source_data_size &&
+           published->header.w == transform_intermediate_source_w &&
+           published->header.h == transform_intermediate_source_h &&
+           published->header.stride == transform_intermediate_source_stride &&
+           published->header.flags == transform_intermediate_source_flags &&
+           published->header.cf == LV_COLOR_FORMAT_RGB565 &&
+           lv_draw_buf_has_flag(published, LV_IMAGE_FLAGS_USER3);
+}
+
+static bool transform_intermediate_key_equal(const transform_intermediate_key_t * a,
+                                             const transform_intermediate_key_t * b)
+{
+    return memcmp(a, b, sizeof(*a)) == 0;
+}
+
+static uint64_t transform_intermediate_key_hash(const transform_intermediate_key_t * key)
+{
+    const uint8_t * p = (const uint8_t *)key;
+    uint64_t hash = 1469598103934665603ULL;
+    for(size_t i = 0; i < sizeof(*key); i++) {
+        hash = (hash ^ p[i]) * 1099511628211ULL;
+    }
+    return hash;
+}
+
+static int32_t transform_intermediate_hash_slot_locked(uint64_t hash, const transform_intermediate_key_t * key)
+{
+    uint32_t start = (uint32_t)hash & (TRANSFORM_INTERMEDIATE_HASH_SIZE - 1U);
+    for(uint32_t n = 0; n < TRANSFORM_INTERMEDIATE_HASH_SIZE; n++) {
+        uint32_t slot = (start + n) & (TRANSFORM_INTERMEDIATE_HASH_SIZE - 1U);
+        uint8_t ref = transform_intermediate_hash[slot];
+        if(ref == 0) return -1;
+        transform_intermediate_candidate_t * candidate = &transform_intermediate_candidates[ref - 1U];
+        if(candidate->valid && candidate->hash == hash && transform_intermediate_key_equal(&candidate->key, key))
+            return (int32_t)(ref - 1U);
+    }
+    return -1;
+}
+
+static bool transform_intermediate_hash_insert_locked(uint8_t candidate_index)
+{
+    transform_intermediate_candidate_t * candidate = &transform_intermediate_candidates[candidate_index];
+    uint32_t start = (uint32_t)candidate->hash & (TRANSFORM_INTERMEDIATE_HASH_SIZE - 1U);
+    for(uint32_t n = 0; n < TRANSFORM_INTERMEDIATE_HASH_SIZE; n++) {
+        uint32_t slot = (start + n) & (TRANSFORM_INTERMEDIATE_HASH_SIZE - 1U);
+        if(transform_intermediate_hash[slot] == 0) {
+            transform_intermediate_hash[slot] = candidate_index + 1U;
+            return true;
+        }
+    }
+    return false;
+}
+
+static void transform_intermediate_hash_remove_locked(uint8_t candidate_index)
+{
+    const uint32_t mask = TRANSFORM_INTERMEDIATE_HASH_SIZE - 1U;
+    uint32_t home = (uint32_t)transform_intermediate_candidates[candidate_index].hash & mask;
+    uint32_t hole = home;
+    for(uint32_t n = 0; n < TRANSFORM_INTERMEDIATE_HASH_SIZE; n++) {
+        if(transform_intermediate_hash[hole] == 0) return;
+        if(transform_intermediate_hash[hole] == candidate_index + 1U) break;
+        hole = (hole + 1U) & mask;
+    }
+    if(transform_intermediate_hash[hole] != candidate_index + 1U) return;
+
+    transform_intermediate_hash[hole] = 0;
+    uint32_t scan = (hole + 1U) & mask;
+    for(uint32_t n = 0; n < TRANSFORM_INTERMEDIATE_HASH_SIZE - 1U; n++) {
+        uint8_t ref = transform_intermediate_hash[scan];
+        if(ref == 0) break;
+        transform_intermediate_candidate_t * candidate = &transform_intermediate_candidates[ref - 1U];
+        uint32_t candidate_home = (uint32_t)candidate->hash & mask;
+        uint32_t distance_to_hole = (hole - candidate_home) & mask;
+        uint32_t distance_to_scan = (scan - candidate_home) & mask;
+        if(distance_to_hole < distance_to_scan) {
+            transform_intermediate_hash[hole] = ref;
+            transform_intermediate_hash[scan] = 0;
+            hole = scan;
+        }
+        scan = (scan + 1U) & mask;
+    }
+}
+
+static transform_intermediate_candidate_t * transform_intermediate_candidate_find_locked(const transform_intermediate_key_t * key,
+                                                                                           uint64_t hash)
+{
+    int32_t i = transform_intermediate_hash_slot_locked(hash, key);
+    return i < 0 ? NULL : &transform_intermediate_candidates[i];
+}
+
+static bool transform_intermediate_candidate_better(const transform_intermediate_candidate_t * a,
+                                                     const transform_intermediate_candidate_t * b)
+{
+    if(!a) return false;
+    if(!b) return true;
+    if(a->distinct_epochs != b->distinct_epochs) return a->distinct_epochs > b->distinct_epochs;
+    uint64_t a_bytes = (uint64_t)a->key.dst_w * a->key.dst_h * 3U;
+    uint64_t b_bytes = (uint64_t)b->key.dst_w * b->key.dst_h * 3U;
+    if(a_bytes != b_bytes) return a_bytes < b_bytes;
+    return a->first_seen_order < b->first_seen_order;
+}
+
+static transform_intermediate_candidate_t * transform_intermediate_observe_locked(const transform_intermediate_key_t * key,
+                                                                                    uint64_t hash)
+{
+    transform_intermediate_candidate_t * candidate = transform_intermediate_candidate_find_locked(key, hash);
+    if(candidate) {
+        if(candidate->last_epoch != transform_intermediate_epoch) {
+            candidate->last_epoch = transform_intermediate_epoch;
+            candidate->distinct_epochs++;
+            transform_intermediate_stats.observations++;
+            if(candidate->distinct_epochs == 2) transform_intermediate_stats.candidate_qualifications++;
+        }
+        return candidate;
+    }
+
+    uint32_t empty = TRANSFORM_INTERMEDIATE_CANDIDATE_COUNT;
+    uint32_t victim = TRANSFORM_INTERMEDIATE_CANDIDATE_COUNT;
+    for(uint32_t i = 0; i < TRANSFORM_INTERMEDIATE_CANDIDATE_COUNT; i++) {
+        transform_intermediate_candidate_t * current = &transform_intermediate_candidates[i];
+        if(!current->valid) {
+            if(empty == TRANSFORM_INTERMEDIATE_CANDIDATE_COUNT) empty = i;
+            continue;
+        }
+        if(current->resident_index >= 0 ||
+           (transform_intermediate_pending.active && transform_intermediate_pending.candidate_index == i)) continue;
+        if(victim == TRANSFORM_INTERMEDIATE_CANDIDATE_COUNT ||
+           transform_intermediate_candidate_better(&transform_intermediate_candidates[victim], current)) victim = i;
+    }
+    uint32_t slot = empty;
+    if(slot == TRANSFORM_INTERMEDIATE_CANDIDATE_COUNT) {
+        slot = victim;
+        if(slot == TRANSFORM_INTERMEDIATE_CANDIDATE_COUNT) return NULL;
+        transform_intermediate_hash_remove_locked((uint8_t)slot);
+        transform_intermediate_stats.candidate_displacements++;
+        lv_memzero(&transform_intermediate_candidates[slot], sizeof(transform_intermediate_candidates[slot]));
+        if(transform_intermediate_candidate_count) transform_intermediate_candidate_count--;
+    }
+    candidate = &transform_intermediate_candidates[slot];
+    lv_memzero(candidate, sizeof(*candidate));
+    candidate->key = *key;
+    candidate->hash = hash;
+    candidate->resident_index = -1;
+    candidate->first_seen_order = ++transform_intermediate_candidate_order;
+    candidate->last_epoch = transform_intermediate_epoch;
+    candidate->distinct_epochs = 1;
+    candidate->valid = true;
+    if(!transform_intermediate_hash_insert_locked((uint8_t)slot)) {
+        lv_memzero(candidate, sizeof(*candidate));
+        return NULL;
+    }
+    transform_intermediate_candidate_count++;
+    transform_intermediate_stats.observations++;
+    return candidate;
+}
+
+static bool transform_intermediate_start_locked(uint8_t candidate_index, uint64_t mem_available_bytes)
+{
+    if(candidate_index >= TRANSFORM_INTERMEDIATE_CANDIDATE_COUNT) return false;
+    transform_intermediate_candidate_t * incoming = &transform_intermediate_candidates[candidate_index];
+    transform_intermediate_key_t * key = &incoming->key;
+    if(!incoming->valid || incoming->distinct_epochs < 2 || incoming->rejected_epochs == incoming->distinct_epochs ||
+       !transform_intermediate_source_matches(key->src) || key->src_cf != LV_COLOR_FORMAT_RGB565 ||
+       key->dst_cf != LV_COLOR_FORMAT_RGB565A8 || key->dst_w <= 0 || key->dst_h <= 0 ||
+       key->dst_w > 512 || key->dst_h > 512) return false;
+
+    uint64_t pixel_bytes = (uint64_t)key->dst_w * key->dst_h * 3U;
+    uint32_t scratch_rows = key->dst_h < TRANSFORM_INTERMEDIATE_BUILD_ROWS ? (uint32_t)key->dst_h : TRANSFORM_INTERMEDIATE_BUILD_ROWS;
+    uint64_t scratch_bytes = (uint64_t)key->dst_w * scratch_rows * 3U;
+    uint64_t output_allocation = pixel_bytes + TRANSFORM_INTERMEDIATE_ALLOC_OVERHEAD;
+    uint64_t scratch_allocation = scratch_bytes + TRANSFORM_INTERMEDIATE_ALLOC_OVERHEAD;
+    uint64_t required = output_allocation + scratch_allocation;
+    uint32_t metadata_bytes = transform_intermediate_metadata_bytes();
+    if(pixel_bytes == 0 || pixel_bytes > TRANSFORM_CACHE_LARGE_ENTRY_MAX ||
+       metadata_bytes > TRANSFORM_INTERMEDIATE_BUDGET || required > TRANSFORM_INTERMEDIATE_BUDGET - metadata_bytes ||
+       mem_available_bytes < TRANSFORM_INTERMEDIATE_PRESSURE_LOW + required) return false;
+
+    bool evict[TRANSFORM_INTERMEDIATE_ENTRY_COUNT] = { false };
+    uint32_t projected_bytes = transform_intermediate_pixel_bytes;
+    uint32_t projected_count = transform_intermediate_entry_count;
+    while((uint64_t)projected_bytes + transform_intermediate_scratch_bytes + required > TRANSFORM_INTERMEDIATE_BUDGET - metadata_bytes ||
+          projected_count >= TRANSFORM_INTERMEDIATE_ENTRY_COUNT) {
+        uint32_t victim = TRANSFORM_INTERMEDIATE_ENTRY_COUNT;
+        transform_intermediate_candidate_t * worst = NULL;
+        for(uint32_t i = 0; i < TRANSFORM_INTERMEDIATE_ENTRY_COUNT; i++) {
+            transform_intermediate_entry_t * entry = &transform_intermediate_cache[i];
+            if(!entry->pixels || evict[i]) continue;
+            int32_t ci = transform_intermediate_hash_slot_locked(transform_intermediate_key_hash(&entry->key), &entry->key);
+            transform_intermediate_candidate_t * resident = ci < 0 ? NULL : &transform_intermediate_candidates[ci];
+            if(!resident || transform_intermediate_candidate_better(incoming, resident)) {
+                if(victim == TRANSFORM_INTERMEDIATE_ENTRY_COUNT || transform_intermediate_candidate_better(worst, resident)) {
+                    victim = i;
+                    worst = resident;
+                }
+            }
+        }
+        if(victim == TRANSFORM_INTERMEDIATE_ENTRY_COUNT) {
+            incoming->rejected_epochs = incoming->distinct_epochs;
+            return false;
+        }
+        evict[victim] = true;
+        projected_bytes -= transform_intermediate_cache[victim].bytes;
+        projected_count--;
+    }
+
+    for(uint32_t i = 0; i < TRANSFORM_INTERMEDIATE_ENTRY_COUNT; i++) {
+        if(!evict[i]) continue;
+        transform_intermediate_entry_t * entry = &transform_intermediate_cache[i];
+        int32_t ci = transform_intermediate_hash_slot_locked(transform_intermediate_key_hash(&entry->key), &entry->key);
+        if(ci >= 0) {
+            transform_intermediate_candidate_t * displaced = &transform_intermediate_candidates[ci];
+            displaced->resident_index = -1;
+            displaced->rejected_epochs = displaced->distinct_epochs;
+        }
+        transform_intermediate_pixel_bytes -= entry->bytes;
+        transform_intermediate_entry_count--;
+        lv_free(entry->pixels);
+        lv_memzero(entry, sizeof(*entry));
+        transform_intermediate_stats.evictions++;
+    }
+
+    uint8_t * pixels = lv_malloc((uint32_t)pixel_bytes);
+    uint8_t * scratch = lv_malloc((uint32_t)scratch_bytes);
+    if(!pixels || !scratch) {
+        if(pixels) lv_free(pixels);
+        if(scratch) lv_free(scratch);
+        return false;
+    }
+    transform_intermediate_pending.key = *key;
+    transform_intermediate_pending.pixels = pixels;
+    transform_intermediate_pending.scratch = scratch;
+    transform_intermediate_pending.pixel_bytes = (uint32_t)pixel_bytes;
+    transform_intermediate_pending.output_allocation_bytes = (uint32_t)output_allocation;
+    transform_intermediate_pending.scratch_allocation_bytes = (uint32_t)scratch_allocation;
+    transform_intermediate_pending.candidate_index = candidate_index;
+    transform_intermediate_pending.active = true;
+    transform_intermediate_pixel_bytes += (uint32_t)output_allocation;
+    transform_intermediate_scratch_bytes = (uint32_t)scratch_allocation;
+    return true;
+}
+
+static bool transform_intermediate_slice_locked(void)
+{
+    transform_intermediate_pending_t * pending = &transform_intermediate_pending;
+    if(!pending->active || !pending->pixels || !pending->scratch ||
+       !transform_intermediate_source_matches(pending->key.src)) {
+        transform_intermediate_cancel_pending_locked();
+        return false;
+    }
+    transform_intermediate_key_t * key = &pending->key;
+    uint32_t rows = (uint32_t)key->dst_h - pending->next_row;
+    if(rows > TRANSFORM_INTERMEDIATE_BUILD_ROWS) rows = TRANSFORM_INTERMEDIATE_BUILD_ROWS;
+    if(rows == 0) return false;
+    uint64_t start_us = transform_intermediate_time_us();
+    lv_draw_image_dsc_t draw_dsc;
+    lv_draw_image_dsc_init(&draw_dsc);
+    draw_dsc.src = key->src;
+    draw_dsc.rotation = key->rotation;
+    draw_dsc.scale_x = key->scale_x;
+    draw_dsc.scale_y = key->scale_y;
+    draw_dsc.pivot.x = key->pivot_x;
+    draw_dsc.pivot.y = key->pivot_y;
+    draw_dsc.recolor = lv_color_hex(key->recolor);
+    draw_dsc.recolor_opa = key->recolor_opa;
+    draw_dsc.antialias = key->antialias;
+    lv_draw_image_sup_t sup;
+    lv_memzero(&sup, sizeof(sup));
+    sup.alpha_color = lv_color_hex(key->alpha_color);
+    lv_area_t dest_area = { .x1 = key->dst_x1,
+                            .y1 = key->dst_y1 + (int32_t)pending->next_row,
+                            .x2 = key->dst_x1 + key->dst_w - 1,
+                            .y2 = key->dst_y1 + (int32_t)pending->next_row + (int32_t)rows - 1 };
+    const lv_draw_buf_t * source = transform_intermediate_source;
+    if(pending->next_row == 0) {
+        lv_area_t full_area = { .x1 = key->dst_x1, .y1 = key->dst_y1,
+                               .x2 = key->dst_x1 + key->dst_w - 1,
+                               .y2 = key->dst_y1 + key->dst_h - 1 };
+        pending->opaque_valid = lv_draw_sw_transform_rgb565_nearest(&full_area, source->data,
+            (int32_t)source->header.w, (int32_t)source->header.h, (int32_t)source->header.stride,
+            &draw_dsc, NULL, 0, &pending->opaque_area, NULL, 0, 0);
+        if(pending->opaque_valid) {
+            pending->opaque_valid = pending->opaque_area.x1 <= pending->opaque_area.x2 &&
+                                    pending->opaque_area.y1 <= pending->opaque_area.y2;
+        }
+    }
+    lv_draw_sw_transform(&dest_area, source->data, (int32_t)source->header.w, (int32_t)source->header.h,
+                         (int32_t)source->header.stride, &draw_dsc, &sup, LV_COLOR_FORMAT_RGB565, pending->scratch);
+    if(key->recolor_opa > LV_OPA_MIN) {
+        lv_area_t chunk_area = { .x1 = 0, .y1 = 0, .x2 = key->dst_w - 1, .y2 = (int32_t)rows - 1 };
+        recolor(chunk_area, pending->scratch, pending->scratch, key->dst_w * 2,
+                LV_COLOR_FORMAT_RGB565A8, &draw_dsc);
+    }
+    size_t full_color_bytes = (size_t)key->dst_w * key->dst_h * 2U;
+    size_t chunk_color_bytes = (size_t)key->dst_w * rows * 2U;
+    for(uint32_t y = 0; y < rows; y++) {
+        size_t dst_row = (size_t)(pending->next_row + y) * key->dst_w;
+        lv_memcpy(pending->pixels + dst_row * 2U, pending->scratch + (size_t)y * key->dst_w * 2U,
+                  (size_t)key->dst_w * 2U);
+        const uint8_t * alpha_row = pending->scratch + chunk_color_bytes + (size_t)y * key->dst_w;
+        lv_memcpy(pending->pixels + full_color_bytes + dst_row, alpha_row, (size_t)key->dst_w);
+        /* Verify the mapper's conservative interior against the actual cached
+         * alpha plane, incrementally inside the existing construction slice. */
+        int32_t relative_y = key->dst_y1 + (int32_t)(pending->next_row + y);
+        if(pending->opaque_valid && relative_y >= pending->opaque_area.y1 && relative_y <= pending->opaque_area.y2) {
+            for(int32_t x = pending->opaque_area.x1; x <= pending->opaque_area.x2; x++) {
+                if(alpha_row[x - key->dst_x1] != LV_OPA_COVER) {
+                    pending->opaque_valid = false;
+                    break;
+                }
+            }
+        }
+    }
+    pending->next_row += rows;
+    uint64_t end_us = transform_intermediate_time_us();
+    uint64_t elapsed_us = end_us >= start_us ? end_us - start_us : 0;
+    transform_intermediate_stats.build_us_total += elapsed_us;
+    if(elapsed_us > transform_intermediate_stats.build_us_max) transform_intermediate_stats.build_us_max = elapsed_us;
+    if(elapsed_us > transform_intermediate_stats.slice_us_max) transform_intermediate_stats.slice_us_max = elapsed_us;
+    if(pending->next_row < (uint32_t)key->dst_h) return true;
+
+    int32_t slot = -1;
+    for(uint32_t i = 0; i < TRANSFORM_INTERMEDIATE_ENTRY_COUNT; i++) {
+        if(!transform_intermediate_cache[i].pixels) { slot = (int32_t)i; break; }
+    }
+    if(slot < 0) {
+        transform_intermediate_cancel_pending_locked();
+        return false;
+    }
+    uint8_t ci = pending->candidate_index;
+    transform_intermediate_entry_t * entry = &transform_intermediate_cache[slot];
+    entry->key = *key;
+    entry->pixels = pending->pixels;
+    entry->bytes = pending->output_allocation_bytes;
+    entry->last_used = ++transform_intermediate_clock;
+    entry->opaque_area = pending->opaque_area;
+    entry->opaque_valid = pending->opaque_valid;
+    transform_intermediate_candidates[ci].resident_index = (int8_t)slot;
+    transform_intermediate_entry_count++;
+    transform_intermediate_stats.builds++;
+    lv_free(pending->scratch);
+    transform_intermediate_scratch_bytes = 0;
+    lv_memzero(pending, sizeof(*pending));
+    return true;
+}
+
+void lv_draw_sw_image_cache_set_intermediate_source(const void * src)
+{
+    if(!transform_cache_initialized) return;
+    const lv_draw_buf_t * published = NULL;
+    if(src && lv_image_src_get_type(src) == LV_IMAGE_SRC_VARIABLE) {
+        published = (const lv_draw_buf_t *)src;
+        if(!published->data || published->header.cf != LV_COLOR_FORMAT_RGB565 ||
+           published->header.w < 1 || published->header.h < 1 ||
+           published->header.w > 512 || published->header.h > 512 ||
+           published->header.stride > INT32_MAX ||
+           (uint64_t)published->header.stride < (uint64_t)published->header.w * 2U ||
+           (uint64_t)published->header.stride * published->header.h > published->data_size ||
+           !lv_draw_buf_has_flag(published, LV_IMAGE_FLAGS_USER3)) published = NULL;
+    }
+    else published = NULL;
+
+    lv_mutex_lock(&transform_cache_mutex);
+    bool same = published && published == transform_intermediate_source &&
+                published->data == transform_intermediate_source_data &&
+                published->data_size == transform_intermediate_source_data_size &&
+                published->header.stride == transform_intermediate_source_stride &&
+                published->header.w == transform_intermediate_source_w &&
+                published->header.h == transform_intermediate_source_h &&
+                published->header.flags == transform_intermediate_source_flags;
+    if(same) {
+        lv_mutex_unlock(&transform_cache_mutex);
+        return;
+    }
+    transform_intermediate_clear_locked();
+    lv_memzero(&transform_intermediate_stats, sizeof(transform_intermediate_stats));
+    transform_intermediate_source = published;
+    transform_intermediate_source_data = published ? published->data : NULL;
+    transform_intermediate_source_data_size = published ? published->data_size : 0;
+    transform_intermediate_source_stride = published ? published->header.stride : 0;
+    transform_intermediate_source_w = published ? published->header.w : 0;
+    transform_intermediate_source_h = published ? published->header.h : 0;
+    transform_intermediate_source_flags = published ? published->header.flags : 0;
+    lv_mutex_unlock(&transform_cache_mutex);
+}
+
+void lv_draw_sw_image_cache_set_transition_active(bool active)
+{
+    if(!transform_cache_initialized) return;
+    lv_mutex_lock(&transform_cache_mutex);
+    /* A transition boundary invalidates work-in-progress, while completed
+     * residents and cross-transition evidence remain reusable. */
+    transform_intermediate_cancel_pending_locked();
+    if(active && !transform_intermediate_transition_active) {
+        transform_intermediate_epoch++;
+    }
+    transform_intermediate_transition_active = active;
+    lv_mutex_unlock(&transform_cache_mutex);
+}
+
+void lv_draw_sw_image_cache_service(uint64_t mem_available_bytes, bool allow_idle_build)
+{
+    if(!transform_cache_initialized) return;
+    lv_mutex_lock(&transform_cache_mutex);
+    transform_intermediate_stats.service_calls++;
+    if(mem_available_bytes < TRANSFORM_INTERMEDIATE_PRESSURE_LOW) {
+        transform_intermediate_stats.service_blocked_pressure++;
+        transform_intermediate_pressure_blocked = true;
+        transform_intermediate_clear_locked();
+        lv_mutex_unlock(&transform_cache_mutex);
+        return;
+    }
+    if(transform_intermediate_pressure_blocked) {
+        if(mem_available_bytes < TRANSFORM_INTERMEDIATE_PRESSURE_HIGH) {
+            transform_intermediate_stats.service_blocked_pressure++;
+            lv_mutex_unlock(&transform_cache_mutex);
+            return;
+        }
+        transform_intermediate_pressure_blocked = false;
+    }
+    if(!allow_idle_build) {
+        transform_intermediate_stats.service_blocked_idle++;
+        lv_mutex_unlock(&transform_cache_mutex);
+        return;
+    }
+    if(transform_intermediate_transition_active) {
+        transform_intermediate_stats.service_blocked_transition++;
+        lv_mutex_unlock(&transform_cache_mutex);
+        return;
+    }
+    if(!transform_intermediate_source_matches(transform_intermediate_source)) {
+        transform_intermediate_stats.source_rejections++;
+        transform_intermediate_cancel_pending_locked();
+        lv_mutex_unlock(&transform_cache_mutex);
+        return;
+    }
+
+    if(transform_intermediate_pending.active) {
+        transform_intermediate_slice_locked();
+        lv_mutex_unlock(&transform_cache_mutex);
+        return;
+    }
+
+    int32_t best_index = -1;
+    transform_intermediate_candidate_t * best = NULL;
+    for(uint32_t i = 0; i < TRANSFORM_INTERMEDIATE_CANDIDATE_COUNT; i++) {
+        transform_intermediate_candidate_t * candidate = &transform_intermediate_candidates[i];
+        if(!candidate->valid || candidate->distinct_epochs < 2 ||
+           candidate->resident_index >= 0) continue;
+        uint64_t bytes64 = (uint64_t)candidate->key.dst_w * candidate->key.dst_h * 3U +
+                           TRANSFORM_INTERMEDIATE_ALLOC_OVERHEAD;
+        uint64_t pixel_bytes = bytes64 - TRANSFORM_INTERMEDIATE_ALLOC_OVERHEAD;
+        if(pixel_bytes == 0 || pixel_bytes > TRANSFORM_CACHE_LARGE_ENTRY_MAX) continue;
+        if(candidate->rejected_epochs == candidate->distinct_epochs) continue;
+        if(!best || transform_intermediate_candidate_better(candidate, best)) {
+            best = candidate;
+            best_index = (int32_t)i;
+        }
+    }
+    if(best_index >= 0) {
+        if(transform_intermediate_start_locked((uint8_t)best_index, mem_available_bytes))
+            transform_intermediate_slice_locked();
+    }
+    else transform_intermediate_stats.service_no_candidate++;
+    lv_mutex_unlock(&transform_cache_mutex);
+}
+
+void lv_draw_sw_image_cache_get_intermediate_stats(lv_draw_sw_image_cache_stats_t * out)
+{
+    if(!out) return;
+    if(!transform_cache_initialized) {
+        lv_memzero(out, sizeof(*out));
+        return;
+    }
+    lv_mutex_lock(&transform_cache_mutex);
+    *out = transform_intermediate_stats;
+    out->bytes = transform_intermediate_metadata_bytes() + transform_intermediate_pixel_bytes + transform_intermediate_scratch_bytes;
+    out->entries = transform_intermediate_entry_count;
+    out->candidates = transform_intermediate_candidate_count;
+    out->pending = transform_intermediate_pending.active;
+    out->pending_rows = transform_intermediate_pending.active ? transform_intermediate_pending.next_row : 0;
+    out->qualified_candidates = 0;
+    for(uint32_t i = 0; i < TRANSFORM_INTERMEDIATE_CANDIDATE_COUNT; i++) {
+        if(transform_intermediate_candidates[i].valid && transform_intermediate_candidates[i].distinct_epochs >= 2)
+            out->qualified_candidates++;
+    }
+    lv_mutex_unlock(&transform_cache_mutex);
+}
+
+static bool transform_cache_draw(lv_draw_task_t * t, const lv_draw_image_dsc_t * draw_dsc,
+                                 const lv_image_decoder_dsc_t * decoder_dsc, const lv_draw_image_sup_t * sup,
+                                 const lv_area_t * img_coords, const lv_area_t * clipped_img_area)
+{
+    if(!transform_cache_initialized || !draw_dsc->src || draw_dsc->tile || draw_dsc->rotation != 0 ||
+       (draw_dsc->scale_x == LV_SCALE_NONE && draw_dsc->scale_y == LV_SCALE_NONE) ||
+       draw_dsc->scale_x <= 0 || draw_dsc->scale_y <= 0 ||
+       draw_dsc->scale_x > UINT16_MAX || draw_dsc->scale_y > UINT16_MAX ||
+       draw_dsc->clip_radius || draw_dsc->colorkey || draw_dsc->bitmap_mask_src ||
+       (draw_dsc->recolor_opa > LV_OPA_MIN && draw_dsc->recolor_opa < LV_OPA_MAX)) return false;
+    lv_image_src_t source_type = lv_image_src_get_type(draw_dsc->src);
+    if(source_type != decoder_dsc->src_type) return false;
+    const lv_draw_buf_t * decoded = decoder_dsc->decoded;
+    if(!decoded) return false;
+    if(source_type == LV_IMAGE_SRC_FILE) {
+        /* File decoders that paint incrementally can replace the decoded
+         * storage between areas, so only complete file decodes are reusable. */
+        if(!decoder_dsc->decoder || decoder_dsc->decoder->get_area_cb) return false;
+    }
+    else if(source_type == LV_IMAGE_SRC_VARIABLE) {
+        const lv_draw_buf_t * published = draw_dsc->src;
+        /* USER2 keeps the existing small-cache identity rule. USER3 is the
+         * explicit publication contract for stable large RGB565 artwork. */
+        bool user2 = lv_draw_buf_has_flag(published, LV_IMAGE_FLAGS_USER2);
+        bool user3 = lv_draw_buf_has_flag(published, LV_IMAGE_FLAGS_USER3);
+        if((!user2 && !user3) || (user2 && published != decoded) ||
+           published->data != decoded->data || published->data_size != decoded->data_size ||
+           published->header.w != decoded->header.w || published->header.h != decoded->header.h ||
+           published->header.stride != decoded->header.stride || published->header.cf != decoded->header.cf ||
+           published->header.flags != decoded->header.flags) return false;
+    }
+    else return false;
+
+    char source_path[TRANSFORM_CACHE_PATH_MAX] = {0};
+    if(source_type == LV_IMAGE_SRC_FILE) {
+        size_t source_path_len = lv_strnlen((const char *)draw_dsc->src, sizeof(source_path));
+        if(source_path_len == sizeof(source_path)) return false;
+        lv_memcpy(source_path, draw_dsc->src, source_path_len);
+    }
+
+    if(!decoded || !decoded->data || decoded->header.w < 1 || decoded->header.h < 1 ||
+       decoded->header.w > INT32_MAX || decoded->header.h > INT32_MAX ||
+       decoded->header.stride > INT32_MAX ||
+       (uint64_t)decoded->header.stride <
+           ((uint64_t)decoded->header.w * lv_color_format_get_bpp(decoded->header.cf) + 7U) / 8U ||
+       (uint64_t)decoded->header.stride * decoded->header.h > decoded->data_size) return false;
+    if(decoded->header.cf == LV_COLOR_FORMAT_RGB565A8 &&
+       ((decoded->header.stride & 1U) != 0 ||
+        (uint64_t)decoded->header.stride * decoded->header.h +
+        (uint64_t)(decoded->header.stride / 2U) * decoded->header.h > decoded->data_size)) return false;
+
+    switch(decoded->header.cf) {
+#if LV_DRAW_SW_SUPPORT_RGB565 && LV_DRAW_SW_SUPPORT_RGB565A8
+        case LV_COLOR_FORMAT_RGB565:
+#endif
+#if LV_DRAW_SW_SUPPORT_RGB565_SWAPPED
+        case LV_COLOR_FORMAT_RGB565_SWAPPED:
+#endif
+#if LV_DRAW_SW_SUPPORT_RGB565A8
+        case LV_COLOR_FORMAT_RGB565A8:
+#endif
+#if LV_DRAW_SW_SUPPORT_RGB888
+        case LV_COLOR_FORMAT_RGB888:
+#endif
+#if LV_DRAW_SW_SUPPORT_XRGB8888
+        case LV_COLOR_FORMAT_XRGB8888:
+#endif
+#if LV_DRAW_SW_SUPPORT_ARGB8888
+        case LV_COLOR_FORMAT_ARGB8888:
+#endif
+#if LV_DRAW_SW_SUPPORT_ARGB8888_PREMULTIPLIED
+        case LV_COLOR_FORMAT_ARGB8888_PREMULTIPLIED:
+#endif
+#if LV_DRAW_SW_SUPPORT_A8
+        case LV_COLOR_FORMAT_A8:
+#endif
+#if LV_DRAW_SW_SUPPORT_L8
+        case LV_COLOR_FORMAT_L8:
+#endif
+#if LV_DRAW_SW_SUPPORT_AL88
+        case LV_COLOR_FORMAT_AL88:
+#endif
+            break;
+        default:
+            return false;
+    }
+
+    int64_t src_w64 = (int64_t)img_coords->x2 - img_coords->x1 + 1;
+    int64_t src_h64 = (int64_t)img_coords->y2 - img_coords->y1 + 1;
+    if(src_w64 != decoded->header.w || src_h64 != decoded->header.h ||
+       decoded->header.w > 512 || decoded->header.h > 512) return false;
+    bool large_source = source_type == LV_IMAGE_SRC_VARIABLE &&
+                        lv_draw_buf_has_flag((const lv_draw_buf_t *)draw_dsc->src, LV_IMAGE_FLAGS_USER3);
+    if(large_source) {
+        if(decoded->header.cf != LV_COLOR_FORMAT_RGB565) return false;
+    }
+    else if(decoded->header.w > 128 || decoded->header.h > 128) return false;
+
+    lv_area_t expected_area;
+    lv_image_buf_get_transformed_area(&expected_area, (int32_t)decoded->header.w, (int32_t)decoded->header.h,
+                                      draw_dsc->rotation, draw_dsc->scale_x, draw_dsc->scale_y,
+                                      &draw_dsc->pivot);
+    int64_t draw_x1 = (int64_t)img_coords->x1 + expected_area.x1;
+    int64_t draw_y1 = (int64_t)img_coords->y1 + expected_area.y1;
+    int64_t draw_x2 = (int64_t)img_coords->x1 + expected_area.x2;
+    int64_t draw_y2 = (int64_t)img_coords->y1 + expected_area.y2;
+    if(draw_x1 < INT32_MIN || draw_x2 > INT32_MAX || draw_y1 < INT32_MIN || draw_y2 > INT32_MAX ||
+       clipped_img_area->x1 < draw_x1 || clipped_img_area->y1 < draw_y1 ||
+       clipped_img_area->x2 > draw_x2 || clipped_img_area->y2 > draw_y2) return false;
+    int64_t expected_w = (int64_t)expected_area.x2 - expected_area.x1 + 1;
+    int64_t expected_h = (int64_t)expected_area.y2 - expected_area.y1 + 1;
+    if(expected_w > (large_source ? 512 : 80) || expected_h > (large_source ? 512 : 80)) return false;
+
+    int64_t dst_w64 = (int64_t)clipped_img_area->x2 - clipped_img_area->x1 + 1;
+    int64_t dst_h64 = (int64_t)clipped_img_area->y2 - clipped_img_area->y1 + 1;
+    int64_t dst_x1 = (int64_t)clipped_img_area->x1 - img_coords->x1;
+    int64_t dst_y1 = (int64_t)clipped_img_area->y1 - img_coords->y1;
+    int64_t dst_x2 = dst_x1 + dst_w64 - 1;
+    int64_t dst_y2 = dst_y1 + dst_h64 - 1;
+    if(dst_w64 <= 0 || dst_h64 <= 0 || dst_w64 > INT32_MAX || dst_h64 > INT32_MAX ||
+       dst_x1 < INT32_MIN || dst_x1 > INT32_MAX || dst_y1 < INT32_MIN || dst_y1 > INT32_MAX ||
+       dst_x2 < expected_area.x1 || dst_x2 > expected_area.x2 ||
+       dst_y2 < expected_area.y1 || dst_y2 > expected_area.y2) return false;
+
+    lv_color_format_t dst_cf = decoded->header.cf;
+    if(dst_cf == LV_COLOR_FORMAT_RGB888 || dst_cf == LV_COLOR_FORMAT_XRGB8888) dst_cf = LV_COLOR_FORMAT_ARGB8888;
+    else if(dst_cf == LV_COLOR_FORMAT_RGB565 || dst_cf == LV_COLOR_FORMAT_RGB565_SWAPPED) dst_cf = LV_COLOR_FORMAT_RGB565A8;
+    else if(dst_cf == LV_COLOR_FORMAT_L8) dst_cf = LV_COLOR_FORMAT_AL88;
+
+    uint32_t dst_bpp;
+    if(dst_cf == LV_COLOR_FORMAT_RGB565A8) dst_bpp = 3;
+    else if(dst_cf == LV_COLOR_FORMAT_AL88) dst_bpp = 2;
+    else dst_bpp = lv_color_format_get_size(dst_cf);
+    uint32_t entry_limit = large_source ? TRANSFORM_CACHE_LARGE_ENTRY_MAX : TRANSFORM_CACHE_ENTRY_MAX;
+    if(dst_bpp == 0 || (uint64_t)dst_w64 * (uint64_t)dst_h64 > entry_limit / dst_bpp) return false;
+    uint32_t dst_w = (uint32_t)dst_w64;
+    uint32_t dst_h = (uint32_t)dst_h64;
+    uint32_t pixel_bytes = dst_w * dst_h * dst_bpp;
+    uint32_t src_size = decoded->data_size;
+    transform_cache_key_t key = {
+        .src = source_type == LV_IMAGE_SRC_FILE ? NULL : draw_dsc->src,
+        .decoded_data = decoded->data,
+        .palette = sup->palette,
+        .palette_size = sup->palette_size,
+        .src_data_size = src_size,
+        .src_stride = decoded->header.stride,
+        .src_w = decoded->header.w,
+        .src_h = decoded->header.h,
+        .src_flags = decoded->header.flags,
+        .dst_x1 = (int32_t)dst_x1,
+        .dst_y1 = (int32_t)dst_y1,
+        .dst_w = (int32_t)dst_w,
+        .dst_h = (int32_t)dst_h,
+        .scale_x = draw_dsc->scale_x,
+        .scale_y = draw_dsc->scale_y,
+        .pivot_x = draw_dsc->pivot.x,
+        .pivot_y = draw_dsc->pivot.y,
+        .rotation = draw_dsc->rotation,
+        .alpha_color = sup->alpha_color,
+        .recolor = draw_dsc->recolor,
+        .recolor_opa = draw_dsc->recolor_opa,
+        .src_cf = decoded->header.cf,
+        .dst_cf = dst_cf,
+        .src_type = decoder_dsc->src_type,
+        .antialias = draw_dsc->antialias,
+        .large_source = large_source,
+    };
+    lv_memcpy(key.src_path, source_path, sizeof(key.src_path));
+
+    transform_intermediate_key_t intermediate_key;
+    uint64_t intermediate_hash = 0;
+
+    lv_mutex_lock(&transform_cache_mutex);
+    transform_cache_entry_t * entry = NULL;
+    transform_intermediate_entry_t * intermediate_cached_entry = NULL;
+    bool intermediate_entry = false;
+    bool intermediate_source_eligible = draw_dsc->src == transform_intermediate_source &&
+        transform_intermediate_source_matches(draw_dsc->src);
+    bool intermediate_registered = transform_intermediate_transition_active && intermediate_source_eligible;
+    if(intermediate_source_eligible) {
+        lv_memzero(&intermediate_key, sizeof(intermediate_key));
+        intermediate_key.src = key.src;
+        intermediate_key.decoded_data = key.decoded_data;
+        intermediate_key.src_data_size = key.src_data_size;
+        intermediate_key.src_stride = key.src_stride;
+        intermediate_key.src_w = key.src_w;
+        intermediate_key.src_h = key.src_h;
+        intermediate_key.src_flags = key.src_flags;
+        intermediate_key.dst_x1 = expected_area.x1;
+        intermediate_key.dst_y1 = expected_area.y1;
+        intermediate_key.dst_w = (int32_t)expected_w;
+        intermediate_key.dst_h = (int32_t)expected_h;
+        intermediate_key.scale_x = key.scale_x;
+        intermediate_key.scale_y = key.scale_y;
+        intermediate_key.pivot_x = key.pivot_x;
+        intermediate_key.pivot_y = key.pivot_y;
+        intermediate_key.rotation = key.rotation;
+        intermediate_key.alpha_color = lv_color_to_u32(key.alpha_color);
+        intermediate_key.recolor = lv_color_to_u32(key.recolor);
+        intermediate_key.recolor_opa = key.recolor_opa;
+        intermediate_key.src_cf = (uint8_t)key.src_cf;
+        intermediate_key.dst_cf = (uint8_t)key.dst_cf;
+        intermediate_key.antialias = key.antialias;
+        intermediate_hash = transform_intermediate_key_hash(&intermediate_key);
+        transform_intermediate_candidate_t * candidate = transform_intermediate_transition_active ?
+            transform_intermediate_observe_locked(&intermediate_key, intermediate_hash) :
+            transform_intermediate_candidate_find_locked(&intermediate_key, intermediate_hash);
+        if(candidate && candidate->resident_index >= 0 && candidate->resident_index < TRANSFORM_INTERMEDIATE_ENTRY_COUNT) {
+            transform_intermediate_entry_t * resident = &transform_intermediate_cache[(uint8_t)candidate->resident_index];
+            if(resident->pixels && transform_intermediate_key_equal(&resident->key, &intermediate_key))
+                intermediate_cached_entry = resident;
+        }
+        if(intermediate_cached_entry) {
+            intermediate_entry = true;
+            transform_intermediate_stats.hits++;
+            uint64_t hit_w = (uint64_t)((int64_t)clipped_img_area->x2 - clipped_img_area->x1 + 1);
+            uint64_t hit_h = (uint64_t)((int64_t)clipped_img_area->y2 - clipped_img_area->y1 + 1);
+            transform_intermediate_stats.hit_pixels += hit_w * hit_h;
+            intermediate_cached_entry->last_used = ++transform_intermediate_clock;
+        }
+        else {
+            transform_intermediate_stats.misses++;
+        }
+    }
+    uint32_t pool_start = large_source ? TRANSFORM_CACHE_ENTRY_COUNT : 0;
+    uint32_t pool_end = large_source ? TRANSFORM_CACHE_ALL_ENTRY_COUNT : TRANSFORM_CACHE_ENTRY_COUNT;
+    if(!entry && !intermediate_cached_entry) {
+        for(uint32_t i = pool_start; i < pool_end; i++) {
+            if(transform_cache[i].pixels && transform_cache_key_equal(&transform_cache[i].key, &key)) {
+                entry = &transform_cache[i];
+                break;
+            }
+        }
+    }
+
+    /* Registered transition artwork may use resident rest-cache entries, but
+     * a motion-only miss must not churn that pool. */
+    if(intermediate_registered && !entry && !intermediate_cached_entry) {
+        if(transform_cache_pending_large_valid &&
+           transform_cache_pending_large_key.src == draw_dsc->src) {
+            transform_cache_pending_large_valid = false;
+            transform_cache_pending_large_hits = 0;
+            lv_memzero(&transform_cache_pending_large_key, sizeof(transform_cache_pending_large_key));
+        }
+        lv_mutex_unlock(&transform_cache_mutex);
+        return false;
+    }
+
+    if(entry || intermediate_cached_entry || !large_source) {
+        transform_cache_pending_large_valid = false;
+        transform_cache_pending_large_hits = 0;
+        lv_memzero(&transform_cache_pending_large_key, sizeof(transform_cache_pending_large_key));
+    }
+    else if(transform_cache_pending_large_valid && transform_cache_key_equal(&transform_cache_pending_large_key, &key)) {
+        if(transform_cache_pending_large_hits < UINT8_MAX) transform_cache_pending_large_hits++;
+    }
+    else {
+        transform_cache_pending_large_key = key;
+        transform_cache_pending_large_valid = true;
+        transform_cache_pending_large_hits = 1;
+    }
+    if(!entry && !intermediate_cached_entry && large_source && transform_cache_pending_large_hits < 2) {
+        lv_mutex_unlock(&transform_cache_mutex);
+        return false;
+    }
+
+    if(!entry && !intermediate_cached_entry) {
+        uint32_t * pool_bytes = large_source ? &transform_cache_large_bytes : &transform_cache_bytes;
+        uint32_t pool_limit = large_source ? TRANSFORM_CACHE_LARGE_TOTAL_MAX : TRANSFORM_CACHE_TOTAL_MAX;
+        uint32_t victim = pool_end;
+        while(*pool_bytes + pixel_bytes > pool_limit) {
+            uint64_t oldest = UINT64_MAX;
+            for(uint32_t i = pool_start; i < pool_end; i++) {
+                if(transform_cache[i].pixels && transform_cache[i].last_used < oldest) {
+                    oldest = transform_cache[i].last_used;
+                    victim = i;
+                }
+            }
+            if(victim == pool_end) {
+                lv_mutex_unlock(&transform_cache_mutex);
+                return false;
+            }
+            if(transform_cache[victim].pixels) {
+                *pool_bytes -= transform_cache[victim].bytes;
+                lv_free(transform_cache[victim].pixels);
+                lv_memzero(&transform_cache[victim], sizeof(transform_cache[victim]));
+            }
+        }
+        victim = pool_end;
+        for(uint32_t i = pool_start; i < pool_end; i++) {
+            if(!transform_cache[i].pixels) { victim = i; break; }
+        }
+        if(victim == pool_end) {
+            uint64_t oldest = UINT64_MAX;
+            for(uint32_t i = pool_start; i < pool_end; i++) {
+                if(transform_cache[i].last_used < oldest) {
+                    oldest = transform_cache[i].last_used;
+                    victim = i;
+                }
+            }
+            *pool_bytes -= transform_cache[victim].bytes;
+            lv_free(transform_cache[victim].pixels);
+            lv_memzero(&transform_cache[victim], sizeof(transform_cache[victim]));
+        }
+        /* Make room before allocation so the live cache plus this transient
+         * replacement never exceeds its independent budget. */
+        uint8_t * pixels = lv_malloc(pixel_bytes);
+        if(!pixels) {
+            lv_mutex_unlock(&transform_cache_mutex);
+            return false;
+        }
+        lv_area_t full_relative = { .x1 = (int32_t)dst_x1, .y1 = (int32_t)dst_y1,
+                                    .x2 = (int32_t)dst_x2, .y2 = (int32_t)dst_y2 };
+        lv_draw_sw_transform(&full_relative, decoded->data, (int32_t)decoded->header.w,
+                             (int32_t)decoded->header.h, (int32_t)decoded->header.stride,
+                             draw_dsc, sup, decoded->header.cf, pixels);
+
+        if(draw_dsc->recolor_opa > LV_OPA_MIN && decoded->header.cf != LV_COLOR_FORMAT_L8 &&
+           decoded->header.cf != LV_COLOR_FORMAT_A8) {
+            int32_t recolor_stride = dst_cf == LV_COLOR_FORMAT_RGB565A8 ? (int32_t)dst_w * 2 :
+                                     dst_cf == LV_COLOR_FORMAT_AL88 ? (int32_t)dst_w :
+                                     (int32_t)dst_w * (int32_t)lv_color_format_get_size(dst_cf);
+            lv_area_t output_area = { .x1 = 0, .y1 = 0, .x2 = (int32_t)dst_w - 1,
+                                      .y2 = (int32_t)dst_h - 1 };
+            recolor(output_area, pixels, pixels, recolor_stride, dst_cf, draw_dsc);
+        }
+
+        entry = &transform_cache[victim];
+        entry->key = key;
+        entry->pixels = pixels;
+        entry->bytes = pixel_bytes;
+        *pool_bytes += pixel_bytes;
+    }
+
+    if(!intermediate_entry) entry->last_used = ++transform_cache_clock;
+    lv_draw_sw_blend_dsc_t blend_dsc;
+    lv_memzero(&blend_dsc, sizeof(blend_dsc));
+    blend_dsc.opa = draw_dsc->opa;
+    blend_dsc.blend_mode = draw_dsc->blend_mode;
+    blend_dsc.src_buf = intermediate_entry ? intermediate_cached_entry->pixels : entry->pixels;
+    blend_dsc.src_area = intermediate_entry ? &(lv_area_t){
+        .x1 = img_coords->x1 + intermediate_key.dst_x1,
+        .y1 = img_coords->y1 + intermediate_key.dst_y1,
+        .x2 = img_coords->x1 + intermediate_key.dst_x1 + intermediate_key.dst_w - 1,
+        .y2 = img_coords->y1 + intermediate_key.dst_y1 + intermediate_key.dst_h - 1,
+    } : clipped_img_area;
+    blend_dsc.blend_area = clipped_img_area;
+    blend_dsc.src_color_format = dst_cf;
+    if(decoded->header.cf == LV_COLOR_FORMAT_L8 || decoded->header.cf == LV_COLOR_FORMAT_A8)
+        blend_dsc.color = draw_dsc->recolor;
+    if(dst_cf == LV_COLOR_FORMAT_RGB565A8) {
+        blend_dsc.src_color_format = LV_COLOR_FORMAT_RGB565;
+        uint32_t blend_w = intermediate_entry ? (uint32_t)intermediate_key.dst_w : dst_w;
+        uint32_t blend_h = intermediate_entry ? (uint32_t)intermediate_key.dst_h : dst_h;
+        blend_dsc.src_stride = (int32_t)blend_w * 2;
+        blend_dsc.mask_buf = blend_dsc.src_buf + (size_t)blend_w * blend_h * 2;
+        blend_dsc.mask_area = blend_dsc.src_area;
+        blend_dsc.mask_stride = (int32_t)blend_w;
+        blend_dsc.mask_res = LV_DRAW_SW_MASK_RES_CHANGED;
+    }
+    else if(dst_cf == LV_COLOR_FORMAT_AL88) {
+        blend_dsc.src_color_format = LV_COLOR_FORMAT_L8;
+        blend_dsc.src_stride = (int32_t)dst_w;
+        blend_dsc.mask_buf = entry->pixels + (size_t)dst_w * dst_h;
+        blend_dsc.mask_area = clipped_img_area;
+        blend_dsc.mask_stride = (int32_t)dst_w;
+        blend_dsc.mask_res = LV_DRAW_SW_MASK_RES_CHANGED;
+    }
+    else if(dst_cf == LV_COLOR_FORMAT_A8) {
+        blend_dsc.src_buf = NULL;
+        blend_dsc.mask_buf = entry->pixels;
+        blend_dsc.mask_area = clipped_img_area;
+        blend_dsc.mask_stride = (int32_t)dst_w;
+        blend_dsc.mask_res = LV_DRAW_SW_MASK_RES_CHANGED;
+        blend_dsc.color = draw_dsc->recolor;
+    }
+    else {
+        blend_dsc.src_stride = (int32_t)dst_w * lv_color_format_get_size(dst_cf);
+    }
+    /* Fractional opacity and other blend modes retain the original mask:
+     * removing alpha 255 there can change LVGL's integer opacity rounding. */
+    lv_area_t opaque_area;
+    bool opaque_hit = intermediate_entry && intermediate_cached_entry->opaque_valid &&
+                      draw_dsc->opa == LV_OPA_COVER && draw_dsc->blend_mode == LV_BLEND_MODE_NORMAL &&
+                      t->target_layer->color_format == LV_COLOR_FORMAT_RGB565;
+    if(opaque_hit) {
+        opaque_area = intermediate_cached_entry->opaque_area;
+        lv_area_move(&opaque_area, img_coords->x1, img_coords->y1);
+        opaque_hit = lv_area_intersect(&opaque_area, &opaque_area, clipped_img_area);
+    }
+    if(opaque_hit) {
+        /* Disjoint strips preserve the A8 perimeter and external layer masks. */
+        lv_area_t strips[4] = {
+            { .x1 = clipped_img_area->x1, .y1 = clipped_img_area->y1,
+              .x2 = clipped_img_area->x2, .y2 = opaque_area.y1 },
+            { .x1 = clipped_img_area->x1, .y1 = opaque_area.y2,
+              .x2 = clipped_img_area->x2, .y2 = clipped_img_area->y2 },
+            { .x1 = clipped_img_area->x1, .y1 = opaque_area.y1,
+              .x2 = opaque_area.x1, .y2 = opaque_area.y2 },
+            { .x1 = opaque_area.x2, .y1 = opaque_area.y1,
+              .x2 = clipped_img_area->x2, .y2 = opaque_area.y2 },
+        };
+        bool has_strip[4] = { clipped_img_area->y1 < opaque_area.y1,
+                              opaque_area.y2 < clipped_img_area->y2,
+                              clipped_img_area->x1 < opaque_area.x1,
+                              opaque_area.x2 < clipped_img_area->x2 };
+        if(has_strip[0]) strips[0].y2--;
+        if(has_strip[1]) strips[1].y1++;
+        if(has_strip[2]) strips[2].x2--;
+        if(has_strip[3]) strips[3].x1++;
+        for(uint32_t i = 0; i < 4; i++) {
+            if(!has_strip[i]) continue;
