+            lv_draw_sw_blend(t, &blend_dsc);
+        }
+        blend_dsc.blend_area = &opaque_area;
+        blend_dsc.mask_buf = NULL;
+        blend_dsc.mask_area = NULL;
+        blend_dsc.mask_res = LV_DRAW_SW_MASK_RES_FULL_COVER;
+        lv_draw_sw_blend(t, &blend_dsc);
+    }
+    else lv_draw_sw_blend(t, &blend_dsc);
+    lv_mutex_unlock(&transform_cache_mutex);
+    return true;
+}
