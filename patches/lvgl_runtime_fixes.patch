+static inline LV_COLOR_16_16_MIX_INLINE uint16_t lv_color_16_16_mix_internal(uint16_t c1, uint16_t c2, uint8_t mix)
+{
+    if(mix == 255) return c1;
+    if(mix == 0) return c2;
+    if(c1 == c2) return c1;
