msgid "GitHub's latest release is not a supported firmware release."
msgstr "Последняя версия GitHub не является поддерживаемой версией прошивки."

#, c-format
msgid "GitHub's latest release has no valid %s image and checksum."
msgstr "В последней версии GitHub нет действительного изображения %s и контрольной суммы."

msgid "Secure connection failed. Check Wi-Fi and the date and time."
msgstr "Безопасное соединение не удалось. Проверьте Wi-Fi, а также дату и время."

msgid "Cannot reach GitHub. Check the Wi-Fi connection."
msgstr "Невозможно получить доступ к GitHub. Проверьте соединение Wi-Fi."

msgid "GitHub did not respond in time. Try again."
msgstr "GitHub не ответил вовремя. Попробуйте еще раз."

msgid "Could not read the release list from GitHub."
msgstr "Не удалось прочитать список выпусков на GitHub."

msgid "GitHub is limiting requests. Try again later."
msgstr "GitHub ограничивает запросы. Повторите попытку позже."

#, c-format
msgid "GitHub returned HTTP %d."
msgstr "GitHub вернул HTTP %d."

msgid "Cannot read the SD card."
msgstr "Невозможно прочитать SD-карту."

msgid "A newer or changed release is available. Check for updates again before downloading."
msgstr "Доступна более новая или измененная версия. Перед загрузкой еще раз проверьте наличие обновлений."

msgid "Insert an SD card to download the update."
msgstr "Вставьте SD-карту, чтобы загрузить обновление."

msgid "The release has no checksum for this device's image."
msgstr "В релизе нет контрольной суммы для образа этого устройства."

msgid "This release's image does not match its checksums. Try again after the next weekly release."
msgstr "Образ этого выпуска не соответствует его контрольным суммам. Повторите попытку после следующего еженедельного выпуска."

msgid "Not enough free space on the SD card for the update."
msgstr "Недостаточно свободного места на SD-карте для обновления."

msgid "The download did not complete. Check Wi-Fi and try again."
msgstr "Загрузка не завершилась. Проверьте Wi-Fi и повторите попытку."

msgid "The downloaded image failed verification and was deleted."
msgstr "Проверка загруженного образа не пройдена; файл удален."

msgid "The SD card changed during the download."
msgstr "SD-карта менялась во время загрузки."

msgid "Could not record the verified update on the SD card."
msgstr "Не удалось сохранить сведения о проверенном обновлении на SD-карте."

msgid "Could not place the update on the SD card."
msgstr "Не удалось разместить обновление на SD-карте."

msgid "Could not start the update check."
msgstr "Не удалось запустить проверку обновлений."

msgid "Could not start the download."
msgstr "Не удалось начать загрузку."

msgid "No verified update is on this SD card. Download it again."
msgstr "На этой SD-карте нет проверенного файла обновления. Загрузите его снова."

