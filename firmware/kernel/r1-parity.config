# Compas compatibility additions after upstream r1-parity.config.
# main.c and bootloader/sd_ready_real.c explicitly mount FAT with codepage=936.
CONFIG_NLS_CODEPAGE_936=y
CONFIG_FAT_DEFAULT_CODEPAGE=936

# Keep the vendor Wi-Fi driver and ABI-sensitive structures for the first
# comparison. brcmfmac needs a coordinated Wi-Fi/Bluetooth userspace migration.
CONFIG_CFG80211=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_INGRESS=y
CONFIG_DEBUG_FS=y

# Keep readable kernel traces while diagnosing warm reboot failures.
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
