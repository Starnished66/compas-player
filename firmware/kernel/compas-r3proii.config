# Compas R3 compatibility additions. OEM display and radio modules remain selected.
# Player and bootloader mount FAT with codepage 936.
CONFIG_NLS_CODEPAGE_936=y
CONFIG_FAT_DEFAULT_CODEPAGE=936

# Retain ABI-sensitive network structures and readable boot traces.
CONFIG_CFG80211=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_INGRESS=y
CONFIG_DEBUG_FS=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y

# Keep CFQ for the initial kernel compatibility comparison.
CONFIG_IOSCHED_CFQ=y
CONFIG_DEFAULT_CFQ=y
CONFIG_DEFAULT_IOSCHED="cfq"
# Compiled-in swap support using ZRAM with LZ4 compression.
CONFIG_SWAP=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_ZRAM_LZ4_COMPRESS=y
