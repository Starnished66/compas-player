# Compas R1 candidate, applied after upstream r1-parity.config.
# This is an experimental build profile; it has not passed device validation.

# Preserve our SD mount policy and stock-module ABI requirements.
CONFIG_NLS_CODEPAGE_936=y
CONFIG_FAT_DEFAULT_CODEPAGE=936
CONFIG_CFG80211=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_INGRESS=y
CONFIG_DEBUG_FS=y

# Remove unused resident facilities; ntfs-3g supplies NTFS in userspace.
# Both cywdhd and brcmfmac are fullmac and retain cfg80211 above.
# CONFIG_MAC80211 is not set
# CONFIG_NTFS_FS is not set
# CONFIG_BT_HS is not set
CONFIG_KALLSYMS=y
# CONFIG_KALLSYMS_ALL is not set

# Keep both schedulers and the measured stock default. Our initial deadline
# comparison was mixed; use COMPAS_SD_SCHEDULER for explicit experiments.
CONFIG_IOSCHED_CFQ=y
CONFIG_IOSCHED_DEADLINE=y
CONFIG_DEFAULT_CFQ=y
# CONFIG_DEFAULT_DEADLINE is not set
CONFIG_DEFAULT_IOSCHED="cfq"

# Make compressed RAM swap available. Runtime activation remains a separate
# measured choice; compiling support does not activate swap.
CONFIG_SWAP=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_ZRAM_LZ4_COMPRESS=y
