# Optional R1 build selection for the open-source Broadcom FullMAC SDIO stack.
# This fragment changes no default build; select it with --wifi-stack brcmfmac.
CONFIG_CFG80211=y
CONFIG_FW_LOADER=y
CONFIG_BRCMUTIL=m
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_SDIO=y
# Keep the built-in board power provider resident for the radio lifetime API.
# Forced module unload could otherwise bypass the normal dependency reference.
# CONFIG_MODULE_FORCE_UNLOAD is not set
