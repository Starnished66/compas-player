+// Final teardown runs only after this module's sysfs/rfkill callbacks and
+// probe work are quiesced. Try the normal MMC transition first, then balance
+// our GPIO/clock ownership even if that transition failed.
+static void wifi_power_teardown(void)
+{
+	int ret = wifi_power_down();
+
+	if (ret) {
+		dev_err(&radio_pdev->dev, "forcing Wi-Fi power off after MMC error %d\n", ret);
+		wifi_power_force_off();
+	}
