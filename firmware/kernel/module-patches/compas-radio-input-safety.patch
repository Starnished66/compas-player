+// Final teardown must release GPIO and clock ownership even when MMC refuses
+// the ordinary power-save transition. Call only after users are quiesced.
+static void wifi_power_force_off(void)
+{
+	if (!wifi_on)
+		return;
+	gpio_set_value_cansleep(wl_reg_on, 0);
+	ingenic_rtc32k_disable();
+	wifi_on = false;
