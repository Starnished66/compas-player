+static int adc_keyboard_validate(struct adc_keys_data *pdata, int channel)
+{
+	unsigned int i, count = 0;
+	bool terminated = false;
+
+	if (!pdata || !pdata->key_info || channel < 0 || channel >= ADC_KEY_CHANNELS ||
+	    pdata->adc_init_value < 0 || pdata->adc_init_value > ADC_KEY_MAX_MV ||
+	    pdata->adc_deviation <= 0 || pdata->adc_deviation > ADC_KEY_MAX_MV ||
+	    pdata->adc_key_detectime <= 0 || pdata->adc_key_detectime > 1000) {
+		pr_err("adc keyboard: invalid ADC channel or timing/voltage configuration\n");
+		return -EINVAL;
+	}
+
+	for (i = 0; i < ADC_KEY_MAX; i++) {
+		struct adc_key_info *key = &pdata->key_info[i];
+
+		if (key->code == -1) {
+			terminated = true;
+			break;
+		}
+		if (key->code <= 0 || key->code > KEY_MAX ||
+		    (key->reuse_code != -1 &&
+		     (key->reuse_code <= 0 || key->reuse_code > KEY_MAX)) ||
+		    (key->multifunc_enable != 0 && key->multifunc_enable != 1) ||
+		    (key->multifunc_enable && key->reuse_code < 0) ||
+		    key->value < 0 || key->value > ADC_KEY_MAX_MV) {
+			pr_err("adc keyboard: invalid key table entry %u\n", i + 1);
+			return -EINVAL;
+		}
+		count++;
+	}
+	if (!terminated && pdata->key_info[ADC_KEY_MAX].code == -1)
+		terminated = true;
+	if (!terminated || !count) {
+		pr_err("adc keyboard: key table must contain a valid key and terminator\n");
+		return -EINVAL;
+	}
+	pdata->key_count = count;
+	return 0;
