+/* Only tx_lock callers locate/cache these device references. No card pointer
+ * leaves the core guard; driver unbind is checked while its parent is locked. */
+static int begin_guard(struct mmc_compas_sdio_guard **guard)
+{
+	struct device *child;
+	if (!msc_dev)
+		msc_dev = bus_find_device_by_name(&platform_bus_type, NULL, "md_ingenic,mmc.0");
+	if (!msc_dev)
+		return -ENODEV;
+	if (!host) {
+		child = device_find_child(msc_dev, NULL, match_mmc_host);
+		if (!child)
+			return -ENODEV;
+		host = container_of(child, struct mmc_host, class_dev);
+	}
+	return mmc_compas_sdio_begin(host, msc_dev, guard);
