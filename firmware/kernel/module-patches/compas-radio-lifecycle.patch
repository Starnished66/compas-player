+/* Caller owns radio_lock. Identity is copied, never a borrowed MMC pointer. */
+static int publish_identity(const struct mmc_compas_sdio_identity *id)
+{
+	unsigned int vendor;
+	const char *selected, *source;
+	if (!id->valid || id->function2_vendor != 0x02d0 || id->function2_device != 0xa9a6)
+		return -ENODEV;
+	if (id->azurewave) {
+		if (!strcmp(profile, "ap6212a"))
+			return -ENODEV;
+		vendor = 0x81;
+		selected = "azurewave";
+		source = "cis";
+	} else {
+		/* No tuple is not proof of a module maker. Accept AP only as the
+		 * explicitly selected, stock-observed firmware/NVRAM profile. */
+		if (strcmp(profile, "ap6212a") || (id->maker_tuple_present && id->maker_tuple_value != 0))
+			return -ENODEV;
+		vendor = 0;
+		selected = "ap6212a";
+		source = "profile";
+	}
+	if (identity_state == ID_READY && (chipvendor != vendor || sdio_vendor != id->function2_vendor ||
+					 sdio_device != id->function2_device))
+		return -ENODEV;
+	chipvendor = vendor;
+	sdio_vendor = id->function2_vendor;
+	sdio_device = id->function2_device;
+	identity_profile = selected;
+	identity_source = source;
+	identity_errno = 0;
+	identity_state = ID_READY;
+	return 0;
