+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_MMC_COMPAS_SDIO_H
+#define _LINUX_MMC_COMPAS_SDIO_H
+
+#include <linux/types.h>
+
+struct device;
+struct mmc_host;
+struct mmc_compas_sdio_guard;
+
+struct mmc_compas_sdio_identity {
+	u16 function2_vendor;
+	u16 function2_device;
+	bool valid;
+	bool maker_tuple_present;
+	bool azurewave;
+	u8 maker_tuple_value;
+};
+
+enum mmc_compas_sdio_end_policy {
+	MMC_COMPAS_SDIO_PRESERVE,
+	MMC_COMPAS_SDIO_FORCE,
+	MMC_COMPAS_SDIO_DISCARD,
+};
+
+int mmc_compas_sdio_begin(struct mmc_host *host,
+			  struct device *expected_parent,
+			  struct mmc_compas_sdio_guard **guard);
+int mmc_compas_sdio_identity(struct mmc_compas_sdio_guard *guard,
+			     struct mmc_compas_sdio_identity *identity);
+int mmc_compas_sdio_power(struct mmc_compas_sdio_guard *guard, bool restore);
+/* Register physical-off bootstrap protection after successful provider init. */
+int mmc_compas_sdio_bootstrap_off(void);
+/* Permanent provider physical-off state; publication requires its live guard. */
+int mmc_compas_sdio_set_off(struct mmc_compas_sdio_guard *guard, bool off);
+void mmc_compas_sdio_end(struct mmc_compas_sdio_guard *guard,
+		 enum mmc_compas_sdio_end_policy policy);
+
+#endif /* _LINUX_MMC_COMPAS_SDIO_H */
