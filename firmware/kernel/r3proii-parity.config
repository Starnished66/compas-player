# Parity with the stock R3 Pro II kernel, read off its symbol table
# (boards/r3proii/stock.kallsyms, see tools/compare.py).

# SLAB like the stock kernel. The HiBy modules were built against it and
# inline kmalloc() through its size classes; SLUB has fewer, and a module
# asking for a large constant size would index a cache that does not exist.
CONFIG_SLAB=y
# CONFIG_SLUB is not set

# USB host: drives (SCSI disk under usb-storage) and DACs
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=y

# USB DAC: the stock kernel's audio gadget is uac_sa (patch 0008, its
# f_uac2_* symbols are that function's), not the ALSA-backed UAC1/UAC2
# CONFIG_USB_CONFIGFS_F_UAC1 is not set
# CONFIG_USB_CONFIGFS_F_UAC2 is not set
CONFIG_USB_CONFIGFS_F_UAC_SA=y

# Type-C: the FUSB302B on the CC lines (patch 0004), registered by the stock
# fusb302b_add module; /sys/class/typec/port0 is the USB role switch
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_FUSB302=y

# The GPIO expander gpio_aw95016_add registers is driven by pca953x
CONFIG_GPIO_PCA953X=y
CONFIG_GPIO_PCA953X_IRQ=y

# Built for size, as the stock kernel evidently was: it keeps hundreds of
# small static functions that -O2 inlines away, and its text is smaller even
# with CIFS inside. Kernel text is resident RAM on this device.
CONFIG_CC_OPTIMIZE_FOR_SIZE=y

# Memory compaction, as in the stock kernel (compact_zone, __compact_pgdat):
# without it fragmented free memory cannot be pieced back into the larger
# blocks drivers ask for, on a 56 MB zone that fragments quickly
CONFIG_COMPACTION=y

# LED triggers: the stock kernel registers them for rfkill, the power supplies,
# NAND and the keyboard; "breathing" (patch 0007) is the charging LED's
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_BREATHING=y

# /sys/class/usb_gadget/android0 (state, event, soft_disconnect: patch 0005)
CONFIG_USB_CONFIGFS_UEVENT=y

# Bluetooth HID through userspace, and the filesystems the stock kernel reads
CONFIG_UHID=y
CONFIG_MSDOS_FS=y
CONFIG_ISO9660_FS=y

# FAT long names and the NLS default in UTF-8, as on the stock kernel. Its FAT
# default codepage is 936; 437 here, which only affects 8.3 names that have no
# long name.
CONFIG_FAT_DEFAULT_IOCHARSET="utf8"
CONFIG_NLS_DEFAULT="utf8"

# In the defconfig, not in the stock kernel
# CONFIG_NFS_FS is not set
# CONFIG_EXT4_FS is not set
# CONFIG_EXT2_FS is not set
# CONFIG_CAN is not set
# Ingenic's own CAN and CDBUS drivers do not depend on CAN: off by hand,
# or the link fails on alloc_candev and friends
# CONFIG_INGENIC_CAN is not set
# CONFIG_INGENIC_CDBUS is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_SPI_SPIDEV is not set
# CONFIG_ETHERNET is not set
# CONFIG_PHYLIB is not set
# CONFIG_USB_CONFIGFS_ACM is not set
# CONFIG_USB_CONFIGFS_SERIAL is not set
