# Options the R3 Pro II needs whatever else changes: what the 32 HiBy modules
# link against (boards/r3proii/modules-need.txt) and what the stock kernel
# carries for the stock userspace (boards/r3proii/stock.kallsyms). Merged with
# scripts/kconfig/merge_config.sh; a name this kernel does not know is
# reported and skipped.

# axp2101, cw2015, mp2731: power_supply_*; axp2101: regmap_add_irq_chip
# (REGMAP_IRQ needs patch 0001 to be settable at all)
CONFIG_POWER_SUPPLY=y
CONFIG_REGMAP_IRQ=y
CONFIG_REGULATOR=y

# leds_sgm31324_add, pwm_backlight: led_classdev_*, backlight
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# sa_sound_switch, sa_earpods_adc: switch_dev_register, switch_set_state
CONFIG_SWITCH=y

# Keys, touch, BlueZ AVRCP buttons through /dev/uinput
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y

# Root and data: squashfs (lzo) and ubifs on the SPI NAND
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_LZO=y
CONFIG_MTD_UBI=y
CONFIG_UBIFS_FS=y

# The card and USB drives: FAT and exFAT in the kernel, NTFS through FUSE
# (ntfs-3g is in the stock rootfs)
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_FUSE_FS=y
CONFIG_NLS_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# USB: host mode for DACs and drives, gadget for adb and mass storage (USB
# audio 2.0 in r3proii-parity.config; the stock kernel has no UAC1)
CONFIG_SND_USB_AUDIO=y
CONFIG_USB_STORAGE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y

# Wi-Fi (cywdhd is fullmac: cfg80211, not mac80211) and Bluetooth over UART
CONFIG_CFG80211=y
CONFIG_RFKILL=y
CONFIG_BT=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_HIDP=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_H4=y

# Watchdog (the DT node is "ok"), loop devices
CONFIG_WATCHDOG=y
CONFIG_BLK_DEV_LOOP=y
