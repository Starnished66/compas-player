+#if defined(HIBY_R1) || defined(HIBY_R3PROII)
+static char *saved_ld_library_path;
+static int ld_library_path_was_set;
+static int ld_library_path_changed;
+
+/* Return the stock rfkill state only when it is an unambiguous 0 or 1. */
+static int get_bluetooth_state(void)
+{
+    char state;
+    int fd = open("/sys/class/rfkill/rfkill0/state", O_RDONLY | O_CLOEXEC);
+    if (fd < 0)
+        return -1;
+    ssize_t n = read(fd, &state, 1);
+    close(fd);
+    if (n != 1 || (state != '0' && state != '1'))
+        return -1;
+    return state - '0';
+}
+
+static void restore_bluetooth_if_enabled(int previous_state)
+{
+    if (previous_state == 1) {
+        char *bt_resume_argv[] = { (char *) "/usr/bin/bt_resume", NULL };
+        (void) compas_boot_run_bounded(bt_resume_argv, 10);
+    }
+}
+
+static void restore_ld_library_path(void)
+{
+    if (!ld_library_path_changed)
+        return;
+    if (ld_library_path_was_set)
+        (void) setenv("LD_LIBRARY_PATH", saved_ld_library_path, 1);
+    else
+        (void) unsetenv("LD_LIBRARY_PATH");
+    free(saved_ld_library_path);
+    saved_ld_library_path = NULL;
+    ld_library_path_changed = 0;
+}
+
+static int set_rockbox_library_path(void)
+{
+#ifdef HIBY_R1
+    const char *old_path = getenv("LD_LIBRARY_PATH");
+    size_t old_len = old_path ? strlen(old_path) : 0;
+    size_t rb_len = strlen(BASE_DIR ROCKBOX_DIR);
+    char *path = malloc(rb_len + old_len + (old_len ? 2 : 1));
+    if (!path)
+        return -1;
+
+    if (old_len)
+        snprintf(path, rb_len + old_len + 2, "%s:%s", BASE_DIR ROCKBOX_DIR, old_path);
+    else
+        snprintf(path, rb_len + 1, "%s", BASE_DIR ROCKBOX_DIR);
+
+    saved_ld_library_path = old_path ? strdup(old_path) : NULL;
+    if (old_path && !saved_ld_library_path) {
+        free(path);
+        return -1;
+    }
+    ld_library_path_was_set = old_path != NULL;
+    if (setenv("LD_LIBRARY_PATH", path, 1) != 0) {
+        free(saved_ld_library_path);
+        saved_ld_library_path = NULL;
+        free(path);
+        return -1;
+    }
+    ld_library_path_changed = 1;
+    free(path);
+#endif
+    return 0;
+}
+#endif
 
