            <animation prop="opa" target="song_count" start="0" end="255" duration="200" delay="80" />
            <animation prop="opa" target="panorama_lyrics_dim" start="160" end="0" duration="220" />
            <animation prop="opa" target="dismiss_btn" start="0" end="255" duration="80" />

            <animation prop="opa" target="album" start="0" end="255" duration="180" /></timeline>
