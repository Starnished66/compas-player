<!--
  Example Player layout: every widget role, arranged with flex containers
  instead of absolute coordinates. Sized for the 480x720 and 480x800 screens;
  example_minimal@320x480.xml next to it is the same layout scaled down for
  the 320x480 screen. A variant is picked automatically by file name.
  The contract (role names, what the app does with them, fonts, images,
  constants, timelines) is documented in docs/PLAYER_LAYOUTS.md.

  Copy this file, rename it (the file name, without .xml, is the layout id),
  and pick it in Settings > Display > Player Layout > Layout. A sibling file
  named example_minimal@480x800.xml would be used instead on a 480x800 screen.
-->
<component>
    <consts>
        <px name="margin" value="24"/>
        <px name="cover_size" value="280"/>
        <px name="cover_size_small" value="120"/>
        <px name="pill_height" value="36"/>
        <px name="transport_height" value="96"/>
    </consts>

    <animations>
        <!-- Played once when the Player screen is shown. -->
        <timeline name="screen_enter">
            <animation prop="opa" target="lower_panel" start="0" end="255" duration="300"/>
        </timeline>

        <!-- Played after a new track's title, artist and album are set. -->
        <timeline name="track_change">
            <animation prop="opa" target="title" start="0" end="255" duration="350"/>
            <animation prop="opa" target="artist" start="0" end="255" duration="350" delay="80"/>
            <animation prop="opa" target="album" start="0" end="255" duration="350" delay="160"/>
        </timeline>

        <!-- Opening the lyrics view: the cover shrinks and the controls fade.
             The app hides the controls when this ends and embeds the lyrics
             below the cover and metadata, wherever the layout left them. -->
        <timeline name="lyrics_open">
            <animation prop="width" target="cover_card" start="280" end="120" duration="240"/>
            <animation prop="height" target="cover_card" start="280" end="120" duration="240"/>
            <animation prop="opa" target="lower_panel" start="255" end="0" duration="200"/>
        </timeline>

        <!-- Closing it again. The controls are shown again before this starts. -->
        <timeline name="lyrics_close">
            <animation prop="width" target="cover_card" start="120" end="280" duration="240"/>
            <animation prop="height" target="cover_card" start="120" end="280" duration="240"/>
            <animation prop="opa" target="lower_panel" start="0" end="255" duration="240" delay="100"/>
        </timeline>
    </animations>

    <view extends="lv_obj" width="#screen_w" height="#screen_h" scrollable="false"
          flex_flow="column"
          style_flex_main_place="start" style_flex_cross_place="center"
          style_bg_opa="0" style_border_width="0" style_radius="0"
          style_pad_all="#margin" style_pad_top="56" style_pad_row="10">

        <!-- Background surface for the blurred-cover look. The app fills
             overlay_panel and shows background_img on top of it. Both are
             optional: the app adds hidden ones when a layout has none. -->
        <lv_obj name="overlay_panel" width="#screen_w" height="#screen_h" x="-24" y="-56"
                ignore_layout="true" scrollable="false"
                style_radius="0" style_border_width="0" style_pad_all="0">
            <lv_image name="background_img" hidden="true"/>
        </lv_obj>

        <!-- Cover art, clipped to rounded corners. cover_img is a child of
             cover_card: the app scales it to cover the card. -->
        <lv_obj name="cover_card" width="#cover_size" height="#cover_size" scrollable="false"
                style_radius="12" style_clip_corner="true"
                style_bg_opa="0" style_border_width="0" style_pad_all="0">
            <lv_image name="cover_img" src="default_cover" align="center"/>
            <lv_label name="song_count" text="--/--" align="top_left" x="8" y="8"
                      style_text_font="font_16" style_bg_color="0x000000" style_bg_opa="128"
                      style_radius="100" style_pad_hor="9" style_pad_ver="5"/>
            <lv_obj name="favorite_circle" width="44" height="44" align="bottom_right" x="-8" y="-8"
                    scrollable="false"
                    style_radius="100" style_bg_color="0x000000" style_bg_opa="102"
                    style_border_width="0" style_pad_all="0">
                <lv_image name="favorite_icon" src="collect_out" align="center"/>
            </lv_obj>
        </lv_obj>

        <lv_label name="title" text="" width="100%" style_text_font="player_title" style_text_align="center"/>
        <lv_label name="artist" text="" width="100%" style_text_font="player_meta" style_text_align="center"/>
        <lv_label name="album" text="" width="100%" style_text_font="player_meta" style_text_align="center"/>

        <lv_obj name="quality_pill" width="content" height="#pill_height" scrollable="false"
                flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center"
                style_pad_hor="14" style_pad_column="10"
                style_radius="100" style_bg_color="0x000000" style_bg_opa="51" style_border_width="0">
            <lv_image name="quality_icon" src="quality_waveform"/>
            <lv_label name="format_badge" text="" style_text_font="font_16"/>
        </lv_obj>

        <!-- Everything below fades in on screen_enter and out on lyrics_open. -->
        <lv_obj name="lower_panel" width="100%" height="content" scrollable="false"
                flex_flow="column" style_flex_cross_place="center"
                style_bg_opa="0" style_border_width="0" style_pad_all="0" style_pad_row="8">
            <lv_slider name="progress_slider" width="100%" height="16"/>

            <lv_obj width="100%" height="content" scrollable="false"
                    flex_flow="row" style_flex_main_place="space_between"
                    style_bg_opa="0" style_border_width="0" style_pad_all="0">
                <lv_label name="pos_label" text="0:00" style_text_font="player_meta"/>
                <lv_label name="dur_label" text="--:--" style_text_font="player_meta"/>
            </lv_obj>

            <lv_obj name="transport" width="100%" height="#transport_height" scrollable="false"
                    flex_flow="row" style_flex_main_place="space_between" style_flex_cross_place="center"
                    style_bg_opa="0" style_border_width="0" style_pad_all="0">
                <lv_image name="order_btn" src="order"/>
                <lv_image name="prev_btn" src="btn_prev"/>
                <lv_image name="play_btn" src="btn_play"/>
                <lv_image name="next_btn" src="btn_next"/>
                <lv_image name="more_btn" src="ic_more"/>
            </lv_obj>
        </lv_obj>

        <!-- A visible volume_slider is an indicator only; the app owns volume. -->
        <lv_slider name="volume_slider" width="100" height="10" hidden="true"/>

        <!-- Transparent tap target that leaves the Player. Not part of the
             flex flow: it sits at a fixed spot near the top left corner. -->
        <lv_obj name="dismiss_btn" width="44" height="44" x="-12" y="-20" ignore_layout="true"
                scrollable="false" style_bg_opa="0" style_border_width="0"/>
    </view>
</component>
