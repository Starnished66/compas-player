#!/usr/bin/env python3
"""Host tests for the opt-in runtime overlay hooks in repack_upt.sh."""
from __future__ import annotations

import os
import pathlib
import re
import subprocess
import tempfile

REPO = pathlib.Path(__file__).resolve().parents[4]
REPACK = REPO / "scripts/firmware/package/repack_upt.sh"


def extract_function(source: str, name: str) -> str:
    match = re.search(rf"(?ms)^{re.escape(name)}\(\) \{{\n.*?^\}}", source)
    if not match:
        raise AssertionError(f"missing {name} in repack_upt.sh")
    return match.group(0)


def extract_existing_r3_block(source: str) -> str:
    match = re.search(
        r"(?ms)^if \[\[ \$board != r1 && -n \$\{R3_RUNTIME_OVERLAY:-\} \]\]; then\n.*?^fi",
        source,
    )
    if not match:
        raise AssertionError("missing existing R3_RUNTIME_OVERLAY block in repack_upt.sh")
    return match.group(0)


def invoke(functions: str, board: str, root: pathlib.Path, *,
           r1_overlay: str | None = None) -> subprocess.CompletedProcess[str]:
    script = f"""set -euo pipefail
{functions}
board={board}
work='{root.parent}'
r1_runtime_overlay=
validate_r1_runtime_overlay
apply_r1_runtime_overlay "$work/root"
"""
    env = dict(os.environ)
    env.pop("R1_RUNTIME_OVERLAY", None)
    env.pop("R3_RUNTIME_OVERLAY", None)
    if r1_overlay is not None:
        env["R1_RUNTIME_OVERLAY"] = r1_overlay
    return subprocess.run(["bash", "-c", script], text=True,
                          stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                          check=False, env=env)


def invoke_existing_r3(block: str, board: str, root: pathlib.Path,
                       overlay: str) -> subprocess.CompletedProcess[str]:
    script = f"""set -euo pipefail
board={board}
work='{root.parent}'
{block}
"""
    env = dict(os.environ)
    env["R3_RUNTIME_OVERLAY"] = overlay
    return subprocess.run(["bash", "-c", script], text=True,
                          stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                          check=False, env=env)


def main() -> None:
    source = REPACK.read_text()
    functions = "\n\n".join(
        extract_function(source, name)
        for name in ("validate_r1_runtime_overlay", "apply_r1_runtime_overlay")
    )
    r3_block = extract_existing_r3_block(source)
    apply_at = source.index('apply_r1_runtime_overlay "$work/root"')
    if source.index(r3_block) >= apply_at:
        raise AssertionError("the existing R3 overlay block must retain its ordering")
    standardize_at = source.index('standardize_boot_pipeline.sh" --board "$board" "$work/root"')
    wifi_gate_at = source.index('require_closed_r1_wifi "$work/root"')
    if not apply_at < standardize_at < wifi_gate_at:
        raise AssertionError("R1 overlay must apply before portable standardization and release gates")

    with tempfile.TemporaryDirectory(prefix="repack-runtime-overlay-") as temp:
        base = pathlib.Path(temp)
        target = base / "work/root"
        (target / "usr/bin").mkdir(parents=True)
        (target / "usr/bin/compas_player").write_text("selected-player\n")
        (target / "usr/bin/compas_loader").write_text("selected-loader\n")

        # Unset overlays preserve the original root byte-for-byte.
        result = invoke(functions, "r1", target)
        if result.returncode != 0:
            raise AssertionError(f"unset overlays failed: {result.stdout}")
        if sorted(p.relative_to(target).as_posix() for p in target.rglob("*")) != [
            "usr", "usr/bin", "usr/bin/compas_loader", "usr/bin/compas_player"
        ]:
            raise AssertionError("unset R1 overlay changed the target tree")

        overlay = base / "r1-overlay"
        (overlay / "usr/bin").mkdir(parents=True)
        (overlay / "usr/bin/bluealsad").write_text("selected-daemon\n")
        (overlay / "usr/lib").mkdir(parents=True)
        (overlay / "usr/lib/libssc.so.0.1.0").write_text("selected-ssc\n")
        result = invoke(functions, "r1", target, r1_overlay=str(overlay))
        if result.returncode != 0:
            raise AssertionError(f"valid R1 overlay failed: {result.stdout}")
        if (target / "usr/bin/bluealsad").read_text() != "selected-daemon\n":
            raise AssertionError("R1 runtime overlay was not copied")
        if (target / "usr/lib/libssc.so.0.1.0").read_text() != "selected-ssc\n":
            raise AssertionError("R1 SSC library was not copied")
        if (target / "usr/bin/compas_player").read_text() != "selected-player\n":
            raise AssertionError("R1 overlay replaced the selected player")
        if (target / "usr/bin/compas_loader").read_text() != "selected-loader\n":
            raise AssertionError("R1 overlay replaced the selected bootloader")

        invalid = invoke(functions, "r1", target, r1_overlay=str(base / "missing"))
        if invalid.returncode == 0 or "must be a real directory" not in invalid.stdout:
            raise AssertionError(f"missing R1 overlay was not rejected: {invalid.stdout}")

        symlink = base / "r1-overlay-symlink"
        symlink.symlink_to(overlay, target_is_directory=True)
        invalid = invoke(functions, "r1", target, r1_overlay=str(symlink))
        if invalid.returncode == 0 or "must be a real directory" not in invalid.stdout:
            raise AssertionError(f"symlink R1 overlay root was not rejected: {invalid.stdout}")

        external = base / "external"
        (external / "bin").mkdir(parents=True)
        (external / "bin/compas_player").write_text("wrong-player\n")
        usr_link = base / "r1-usr-link"
        usr_link.mkdir()
        (usr_link / "usr").symlink_to(external, target_is_directory=True)
        invalid = invoke(functions, "r1", target, r1_overlay=str(usr_link))
        if invalid.returncode == 0 or "may not symlink the selected binary parent /usr" not in invalid.stdout:
            raise AssertionError(f"R1 overlay /usr symlink was not rejected: {invalid.stdout}")

        bin_link = base / "r1-bin-link"
        (bin_link / "usr").mkdir(parents=True)
        (bin_link / "usr/bin").symlink_to(external / "bin", target_is_directory=True)
        invalid = invoke(functions, "r1", target, r1_overlay=str(bin_link))
        if invalid.returncode == 0 or "may not symlink the selected binary parent /usr/bin" not in invalid.stdout:
            raise AssertionError(f"R1 overlay /usr/bin symlink was not rejected: {invalid.stdout}")

        conflict = base / "r1-conflict"
        (conflict / "usr/bin").mkdir(parents=True)
        (conflict / "usr/bin/compas_player").write_text("wrong-player\n")
        invalid = invoke(functions, "r1", target, r1_overlay=str(conflict))
        if invalid.returncode == 0 or "may not provide the selected binary /usr/bin/compas_player" not in invalid.stdout:
            raise AssertionError(f"overlay selected-binary conflict was not rejected: {invalid.stdout}")
        if (target / "usr/bin/compas_player").read_text() != "selected-player\n":
            raise AssertionError("rejected conflicting overlay changed the selected player")

        invalid = invoke(functions, "r3proii", target, r1_overlay=str(overlay))
        if invalid.returncode == 0 or "only supported with --board r1" not in invalid.stdout:
            raise AssertionError(f"R1 overlay was accepted for R3: {invalid.stdout}")

        r3_overlay = base / "r3-overlay"
        (r3_overlay / "usr/lib").mkdir(parents=True)
        (r3_overlay / "usr/lib/r3-marker").write_text("r3-overlay\n")
        result = invoke_existing_r3(r3_block, "r3proii", target, str(r3_overlay))
        if result.returncode != 0 or (target / "usr/lib/r3-marker").read_text() != "r3-overlay\n":
            raise AssertionError(f"existing R3 overlay behavior regressed: {result.stdout}")

        # R3_RUNTIME_OVERLAY has never been an R1 input.
        r3_marker = target / "usr/lib/r3-marker"
        r1_target = base / "r1-work/root"
        r1_target.mkdir(parents=True)
        result = invoke_existing_r3(r3_block, "r1", r1_target, str(r3_overlay))
        if result.returncode != 0 or (r1_target / "usr/lib/r3-marker").exists():
            raise AssertionError(f"R3 overlay changed R1 behavior: {result.stdout}")

    print("repack runtime overlay tests passed")


if __name__ == "__main__":
    main()
