+static void parse_img_handle(struct obex_session *os, GObexPacket *req)
+{
+	GObexHeader *hdr;
+	const char *handle;
+
+	g_free(os->img_handle);
+	os->img_handle = NULL;
+
+	hdr = g_obex_packet_get_header(req, OBEX_HDR_IMG_HANDLE);
+	if (hdr == NULL)
+		return;
+
+	if (!g_obex_header_get_unicode(hdr, &handle))
+		return;
+
+	os->img_handle = g_strdup(handle);
+	DBG("IMG-HANDLE: %s", os->img_handle);
+}
+
+static void parse_img_descriptor(struct obex_session *os, GObexPacket *req)
+{
+	GObexHeader *hdr;
+	const void *bytes;
+	gsize len;
+
+	g_free(os->img_descriptor);
+	os->img_descriptor = NULL;
+	os->img_descriptor_len = 0;
+	hdr = g_obex_packet_get_header(req, 0x71);
+	if (hdr == NULL)
+		return;
+	if (!g_obex_header_get_bytes(hdr, &bytes, &len) || len > 1024) {
+		os->img_descriptor_len = 1025;
+		return;
+	}
+	os->img_descriptor = g_memdup2(bytes, len);
+	os->img_descriptor_len = len;
+}
