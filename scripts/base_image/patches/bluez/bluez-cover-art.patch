+/* AVRCP 1.6 section 5.14.2.1 */
+#define COVER_ART_TARGET ((const uint8_t *) \
+	"\x71\x63\xDD\x54\x4A\x7E\x11\xE2\xB4\x7C\x00\x50\xC2\x49\x00\x48")
+#define COVER_ART_TARGET_SIZE 16
+
+#define COVER_ART_MAX_SIZE (1024 * 1024)
+
+#define MPRIS_SERVICE "org.mpris.MediaPlayer2.compas"
+#define MPRIS_PATH "/org/mpris/MediaPlayer2"
+#define MPRIS_PLAYER_INTERFACE "org.mpris.MediaPlayer2.Player"
+#define COVER_ART_DIRECTORY "/tmp/compas-bt-art/"
+
+static GDBusClient *player_client;
+
+struct cover_art_object {
+	int fd;
+	char *contents;		/* Properties document, NULL for images */
+	size_t size;
+	size_t offset;
+};
+
+/* Compás allocates unique seven-digit handles in JPEG filenames. The
+ * RAM counter survives player restarts within a boot; neither daemon hashes
+ * URLs, which would permit collisions. Keep these parsers in sync. */
+static bool cover_art_handle(const char *url, char *handle, size_t len)
+{
+	const char *name = strrchr(url, '/');
+	unsigned int i;
+	if (name == NULL || len < 8 || !g_str_has_prefix(name + 1, "cover-") ||
+			strlen(name + 1) != 17 || strcmp(name + 14, ".jpg") != 0)
+		return false;
+	for (i = 0; i < 7; i++) {
+		if (name[7 + i] < '0' || name[7 + i] > '9')
+			return false;
+	}
+	memcpy(handle, name + 7, 7);
+	handle[7] = '\0';
+	return true;
+}
+
+/*
+ * Controllers fetch lazily and commonly ask for the previous track's
+ * handle after a track change, when the player no longer advertises that
+ * art URL. Remember the last few resolved handles so those requests can
+ * still be answered.
+ */
+#define COVER_ART_CACHE_SIZE 4
+
+struct cover_art_entry {
+	char handle[8];
+	char *filename;
+};
+
+static GQueue cover_art_cache = G_QUEUE_INIT;
+
+static void cover_art_cache_add(const char *handle, const char *filename)
+{
+	struct cover_art_entry *entry;
+	GList *l;
+
+	for (l = cover_art_cache.head; l != NULL; l = g_list_next(l)) {
+		entry = l->data;
+
+		if (!g_str_equal(entry->handle, handle))
+			continue;
+
+		g_free(entry->filename);
+		entry->filename = g_strdup(filename);
+		g_queue_unlink(&cover_art_cache, l);
+		g_queue_push_head_link(&cover_art_cache, l);
+		return;
+	}
+
+	if (g_queue_get_length(&cover_art_cache) >= COVER_ART_CACHE_SIZE) {
+		entry = g_queue_pop_tail(&cover_art_cache);
+		g_free(entry->filename);
+		g_free(entry);
+	}
+
+	entry = g_new0(struct cover_art_entry, 1);
+	strncpy(entry->handle, handle, sizeof(entry->handle) - 1);
+	entry->filename = g_strdup(filename);
+
+	g_queue_push_head(&cover_art_cache, entry);
+}
+
+static char *cover_art_cache_lookup(const char *handle)
+{
+	GList *l;
+
+	for (l = cover_art_cache.head; l != NULL; l = g_list_next(l)) {
+		struct cover_art_entry *entry = l->data;
+
+		if (g_str_equal(entry->handle, handle))
+			return g_strdup(entry->filename);
+	}
+
+	return NULL;
+}
+
+static void cover_art_cache_clear(void)
+{
+	struct cover_art_entry *entry;
+
+	while ((entry = g_queue_pop_head(&cover_art_cache)) != NULL) {
+		g_free(entry->filename);
+		g_free(entry);
+	}
+}
+
+/* Metadata is discovered asynchronously; an OBEX GET never blocks the
+ * main loop on a player or trusts filenames supplied by the controller. */
+static void metadata_changed(GDBusProxy *proxy, const char *property,
+				DBusMessageIter *iter, void *user_data)
+{
+	DBusMessageIter dict;
+
+	if (!g_str_equal(property, "Metadata") || iter == NULL ||
+			dbus_message_iter_get_arg_type(iter) != DBUS_TYPE_ARRAY)
+		return;
+
+	dbus_message_iter_recurse(iter, &dict);
+	while (dbus_message_iter_get_arg_type(&dict) == DBUS_TYPE_DICT_ENTRY) {
+		DBusMessageIter entry, value;
+		const char *key, *url;
+		char *filename;
+		char handle[8];
+
+		dbus_message_iter_recurse(&dict, &entry);
+		if (dbus_message_iter_get_arg_type(&entry) != DBUS_TYPE_STRING)
+			return;
+		dbus_message_iter_get_basic(&entry, &key);
+		if (!dbus_message_iter_next(&entry) ||
+			dbus_message_iter_get_arg_type(&entry) != DBUS_TYPE_VARIANT)
+			return;
+		dbus_message_iter_recurse(&entry, &value);
+		if (g_str_equal(key, "mpris:artUrl") &&
+				dbus_message_iter_get_arg_type(&value) == DBUS_TYPE_STRING) {
+			dbus_message_iter_get_basic(&value, &url);
+			filename = g_filename_from_uri(url, NULL, NULL);
+			if (filename != NULL &&
+					g_str_has_prefix(filename, COVER_ART_DIRECTORY) &&
+					strchr(filename + strlen(COVER_ART_DIRECTORY), '/') == NULL) {
+				if (cover_art_handle(url, handle, sizeof(handle)))
+					cover_art_cache_add(handle, filename);
+			}
+			g_free(filename);
+			return;
+		}
+		dbus_message_iter_next(&dict);
+	}
+}
+
+static void player_connected(DBusConnection *conn, void *user_data)
+{
+	GDBusProxy *proxy;
+
+	proxy = g_dbus_proxy_new(player_client, MPRIS_PATH, MPRIS_PLAYER_INTERFACE);
+	if (proxy == NULL)
+		return;
+	g_dbus_proxy_set_property_watch(proxy, metadata_changed, NULL);
+	g_dbus_proxy_unref(proxy);
+}
+
+static void player_disconnected(DBusConnection *conn, void *user_data)
+{
+	cover_art_cache_clear();
+}
+
+static char *cover_art_lookup(const char *handle)
+{
+	unsigned int i;
+
+	if (handle == NULL || strlen(handle) != 7)
+		return NULL;
+	for (i = 0; i < 7; i++) {
+		if (handle[i] < '0' || handle[i] > '9')
+			return NULL;
+	}
+	return cover_art_cache_lookup(handle);
+}
+
+static void *cover_art_open_image(const char *name, int oflag, mode_t mode,
+					void *context, size_t *size, int *err)
+{
+	struct cover_art_object *obj;
+	struct stat st;
+	char *filename;
+	int fd, dirfd;
+	struct stat directory;
+
+	if (oflag != O_RDONLY) {
+		if (err)
+			*err = -EPERM;
+		return NULL;
+	}
+
+	filename = cover_art_lookup(name);
+	if (filename == NULL) {
+		DBG("no image for handle %s", name ? name : "(none)");
+		if (err)
+			*err = -ENOENT;
+		return NULL;
+	}
+
+	dirfd = open("/tmp/compas-bt-art", O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+	if (dirfd < 0 || fstat(dirfd, &directory) < 0 ||
+			directory.st_uid != geteuid() || (directory.st_mode & 0077)) {
+		if (dirfd >= 0)
+			close(dirfd);
+		g_free(filename);
+		if (err)
+			*err = -EPERM;
+		return NULL;
+	}
+	fd = openat(dirfd, filename + strlen(COVER_ART_DIRECTORY),
+				O_RDONLY | O_NOFOLLOW | O_CLOEXEC | O_NONBLOCK);
+	close(dirfd);
+	g_free(filename);
+
+	if (fd < 0) {
+		if (err)
+			*err = -errno;
+		return NULL;
+	}
+
+	if (fstat(fd, &st) < 0 || !S_ISREG(st.st_mode) ||
+					st.st_size <= 0 || st.st_size > COVER_ART_MAX_SIZE) {
+		close(fd);
+		if (err)
+			*err = -EINVAL;
+		return NULL;
+	}
+
+	obj = g_new0(struct cover_art_object, 1);
+	obj->fd = fd;
+	obj->size = st.st_size;
+
+	if (size)
+		*size = obj->size;
+
+	if (err)
+		*err = 0;
+
+	return obj;
+}
+
+/*
+ * Parse the JPEG start-of-frame marker for the image dimensions, which the
+ * image-properties document has to carry.
+ */
+static gboolean jpeg_dimensions(int fd, unsigned int *width,
+						unsigned int *height)
+{
+	uint8_t buf[4];
+	off_t pos = 2;
+
+	if (lseek(fd, 0, SEEK_SET) < 0)
+		return FALSE;
+
+	if (read(fd, buf, 2) != 2 || buf[0] != 0xff || buf[1] != 0xd8)
+		return FALSE;
+
+	while (lseek(fd, pos, SEEK_SET) >= 0 && read(fd, buf, 4) == 4) {
+		uint16_t len = (buf[2] << 8) | buf[3];
+
+		if (buf[0] != 0xff)
+			return FALSE;
+
+		/* SOF0..SOF3, SOF5..SOF7, SOF9..SOF11, SOF13..SOF15 */
+		if (buf[1] >= 0xc0 && buf[1] <= 0xcf &&
+				buf[1] != 0xc4 && buf[1] != 0xc8 &&
+				buf[1] != 0xcc) {
+			uint8_t sof[5];
+
+			if (read(fd, sof, 5) != 5)
+				return FALSE;
+
+			*height = (sof[1] << 8) | sof[2];
+			*width = (sof[3] << 8) | sof[4];
+
+			return *width == 200 && *height == 200;
+		}
+
+		if (len < 2)
+			return FALSE;
+
+		pos += 2 + len;
+	}
+
+	return FALSE;
+}
+
+static void *cover_art_open_properties(const char *name, int oflag,
+					mode_t mode, void *context,
+					size_t *size, int *err)
+{
+	struct cover_art_object *obj;
+	unsigned int width = 0, height = 0;
+	GString *props;
+
+	obj = cover_art_open_image(name, oflag, mode, context, NULL, err);
+	if (obj == NULL)
+		return NULL;
+
+	if (!jpeg_dimensions(obj->fd, &width, &height)) {
+		close(obj->fd);
+		g_free(obj);
+		if (err)
+			*err = -EINVAL;
+		return NULL;
+	}
+
+	props = g_string_new("<image-properties version=\"1.0\" handle=\"");
+	g_string_append_printf(props, "%s\">\n", name);
+	g_string_append_printf(props,
+		"<native encoding=\"JPEG\" pixel=\"%u*%u\" size=\"%zu\"/>\n",
+		width, height, obj->size);
+	g_string_append(props, "</image-properties>\n");
+
+	close(obj->fd);
+	obj->fd = -1;
+	obj->size = props->len;
+	obj->contents = g_string_free(props, FALSE);
+
+	if (size)
+		*size = obj->size;
+
+	return obj;
+}
+
+static ssize_t cover_art_read(void *object, void *buf, size_t count)
+{
+	struct cover_art_object *obj = object;
+	ssize_t len;
+
+	if (obj->contents != NULL) {
+		len = MIN(count, obj->size - obj->offset);
+		memcpy(buf, obj->contents + obj->offset, len);
+		obj->offset += len;
+
+		return len;
+	}
+
+	len = read(obj->fd, buf, count);
+	if (len < 0)
+		return -errno;
+
+	return len;
+}
+
+static int cover_art_close(void *object)
+{
+	struct cover_art_object *obj = object;
+
+	if (obj->fd >= 0)
+		close(obj->fd);
+
+	g_free(obj->contents);
+	g_free(obj);
+
+	return 0;
+}
+
+static void *cover_art_connect(struct obex_session *os, int *err)
+{
+	DBG("");
+
+	manager_register_session(os);
+
+	if (err)
+		*err = 0;
+
+	return NULL;
+}
+
+static void cover_art_disconnect(struct obex_session *os, void *user_data)
+{
+	DBG("");
+
+	manager_unregister_session(os);
+}
+
+/* BIP accepts exact dimensions, free ranges and fixed-aspect ranges.
+ * Parsing is bounded to the protocol's unsigned 16-bit dimensions. */
+static bool pixel_number(const char **text, unsigned int *value)
+{
+	unsigned int n = 0, digits = 0;
+	while (**text >= '0' && **text <= '9') {
+		if (++digits > 5)
+			return false;
+		n = n * 10 + *(*text)++ - '0';
+	}
+	if (digits == 0 || n > 65535)
+		return false;
+	*value = n;
+	return true;
+}
+
+static bool pixel_supported(const char *text)
+{
+	unsigned int low_w, low_h, high_w, high_h;
+	bool fixed = false;
+	if (*text == '\0')
+		return true;
+	if (!pixel_number(&text, &low_w) || *text++ != '*')
+		return false;
+	if (*text == '*') {
+		fixed = true;
+		text++;
+		low_h = 0;
+	} else if (!pixel_number(&text, &low_h)) {
+		return false;
+	}
+	if (*text == '\0')
+		return !fixed && low_w == 200 && low_h == 200;
+	if (*text++ != '-' || !pixel_number(&text, &high_w) ||
+			*text++ != '*' || !pixel_number(&text, &high_h) || *text)
+		return false;
+	return low_w <= 200 && low_h <= 200 && high_w >= 200 && high_h >= 200 &&
+			(!fixed || high_w == high_h);
+}
+
+struct image_descriptor {
+	unsigned int depth;
+	bool root, image, valid, supported;
+	uint64_t maxsize, size;
+};
+
+static void descriptor_start(GMarkupParseContext *context, const gchar *name,
+				const gchar **names, const gchar **values,
+				gpointer user_data, GError **error)
+{
+	struct image_descriptor *desc = user_data;
+	bool version = false, encoding = false, pixel = false;
+	unsigned int i;
+
+	if (desc->depth == 0 && !desc->root &&
+			g_str_equal(name, "image-descriptor")) {
+		desc->root = true;
+		for (i = 0; names[i] != NULL; i++) {
+			if (!g_str_equal(names[i], "version") ||
+					!g_str_equal(values[i], "1.0") || version)
+				desc->valid = false;
+			version = true;
+		}
+		if (!version)
+			desc->valid = false;
+	} else if (desc->depth == 1 && !desc->image && g_str_equal(name, "image")) {
+		desc->image = true;
+		for (i = 0; names[i] != NULL; i++) {
+			if (g_str_equal(names[i], "encoding")) {
+				if (encoding)
+					desc->valid = false;
+				if (values[i][0] && !g_str_equal(values[i], "JPEG"))
+					desc->supported = false;
+				encoding = true;
+			} else if (g_str_equal(names[i], "pixel")) {
+				if (pixel)
+					desc->valid = false;
+				if (!pixel_supported(values[i]))
+					desc->supported = false;
+				pixel = true;
+			} else if (g_str_equal(names[i], "maxsize") ||
+					g_str_equal(names[i], "size")) {
+				char *end;
+				uint64_t size;
+				errno = 0;
+				size = g_ascii_strtoull(values[i], &end, 10);
+				if (errno || end == values[i] || *end || size == 0 ||
+						values[i][0] < '0' || values[i][0] > '9')
+					desc->valid = false;
+				else if (g_str_equal(names[i], "size"))
+					desc->size = size;
+				else
+					desc->maxsize = size;
+			} else if (g_str_equal(names[i], "transformation")) {
+				/* At identical dimensions these are all no-ops. */
+				if (!g_str_equal(values[i], "crop") &&
+						!g_str_equal(values[i], "stretch") &&
+						!g_str_equal(values[i], "fill"))
+					desc->supported = false;
+			} else {
+				desc->valid = false;
+			}
+		}
+		if (!encoding || !pixel)
+			desc->valid = false;
+	} else {
+		desc->valid = false;
+	}
+	desc->depth++;
+}
+
+static void descriptor_end(GMarkupParseContext *context, const gchar *name,
+				gpointer user_data, GError **error)
+{
+	struct image_descriptor *desc = user_data;
+	if (desc->depth > 0)
+		desc->depth--;
+}
+
+static void descriptor_text(GMarkupParseContext *context, const gchar *text,
+				gsize len, gpointer user_data, GError **error)
+{
+	struct image_descriptor *desc = user_data;
+	gsize i;
+	for (i = 0; i < len; i++) {
+		if (!g_ascii_isspace(text[i]))
+			desc->valid = false;
+	}
+}
+
+static int check_image_descriptor(struct obex_session *os, const char *handle)
+{
+	static const GMarkupParser parser = {
+		descriptor_start, descriptor_end, descriptor_text, NULL, NULL
+	};
+	struct image_descriptor desc = { .valid = true, .supported = true };
+	GMarkupParseContext *context;
+	GError *error = NULL;
+	const uint8_t *bytes;
+	size_t len;
+	bool valid;
+
+	bytes = obex_get_img_descriptor(os, &len);
+	/* An omitted/empty descriptor requests the native image. */
+	if (len == 0)
+		return 0;
+	if (bytes == NULL || len > 1024)
+		return -EBADR;
+	context = g_markup_parse_context_new(&parser, 0, &desc, NULL);
+	valid = g_markup_parse_context_parse(context, (const char *) bytes, len, &error) &&
+			g_markup_parse_context_end_parse(context, &error) &&
+			desc.valid && desc.root && desc.image && desc.depth == 0;
+	g_clear_error(&error);
+	g_markup_parse_context_free(context);
+	if (!valid)
+		return -EBADR;
+	if (!desc.supported)
+		return -ENOTSUP;
+	if (desc.maxsize > 0 || desc.size > 0) {
+		struct cover_art_object *obj;
+		int err;
+		obj = cover_art_open_image(handle, O_RDONLY, 0, NULL, NULL, &err);
+		if (obj == NULL)
+			return err;
+		valid = (desc.maxsize == 0 || obj->size <= desc.maxsize) &&
+			(desc.size == 0 || obj->size == desc.size);
+		cover_art_close(obj);
+		if (!valid)
+			return -ENOTSUP;
+	}
+	return 0;
+}
+
+static int cover_art_get(struct obex_session *os, void *user_data)
+{
+	const char *type = obex_get_type(os);
+	const char *handle = obex_get_img_handle(os);
+
+	DBG("type %s handle %s", type ? type : "(none)",
+					handle ? handle : "(none)");
+
+	if (type == NULL || handle == NULL || strlen(handle) != 7)
+		return -EBADR;
+	if (g_str_equal(type, "x-bt/img-img")) {
+		int err = check_image_descriptor(os, handle);
+		if (err < 0)
+			return err;
+	} else if (!g_str_equal(type, "x-bt/img-properties") &&
+			!g_str_equal(type, "x-bt/img-thm")) {
+		return -ENOTSUP;
+	}
